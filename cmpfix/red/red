'LOAD_ERROR :  % take proper action if initial file open fails
  DUP 18292 EQ_IF  % is it the file-not-found error?
    DROP ERR.NEWFIL ERR.MSG  % yes, let user know
  ELSE  % if not, it's something worse
    SYSMSG TYPE  % display it in the text area
    0 FILE_NAME W!  % don't set the file name if open failed
    ERR.OPFAIL ERR.MSG SETSCREEN  % display open-failure message
  THEN
  ;

0 'RED.OLD_ABORT VARIABLE  % ABORT outside RED

ASSEMBLER<

'RED_ABORT :  % (ABORT while RED runs: restore the terminal, then abort)
  RESET_REGISTERS  % the fault may have left the stacks anywhere
  RED.OLD_ABORT @ ABORT !  % a fault from here on aborts as before
  18 1 STBM 1 18 CUP  % whole screen scrolls; cursor below the message
  11 CLEAR_VT100_CHAR 0A SET_VT100_CHAR  % numeric keypad, wrap on
  % (not RESTORE_VT100: its RESET_VT100 would erase the message)
  BUFFER_OFF E.RESET_CHARS  % DCL's terminal characteristics
  'I_CTRL_C_HNDLR COUNT I_LOOKUP IF
    CODE_COUNT DROP CTRL_C_HANDLER ! THEN  % restore ABORT on control-C
  ABORT @ JMP @(P)+  % and abort as before, from the fault's return stack
  ;

>

'.RED :  % [file name descriptor, -1] or [0], RED
  RED<  % push the RED vocatulary at run-time
  E.SET_CHARS
  ABORT @ RED.OLD_ABORT ! () RED_ABORT ABORT !  % restore the terminal on a fault
BUFFER_ON  % reset origin mode, activate buffer
INIT_VT100 ESC[ "?6l" MSG APPLICATION_KEYPAD WRAP_OFF SMOOTH_SCROLL
 FLUSH E.INIT

%  open file if specified in command line
  IF  % is there a filename?
    FILE_NAME .MOVE_STRING  % yes, save it
  THEN
  SETSCREEN DISP_FLUSH FILE_NAME W@ NEZ_IF  % is there a file name?
    FILE_NAME COUNT F.OPEN_FILE DUP IF DROP ELSE  % yes, load file, successful?
      LOAD_ERROR  % show "new file" if file not found, else error
    REC_SEP CRET <- MAIN_SEP CRET <- THEN THEN
  DISP BUFFER_OFF LOAD_RESET KBD  % close files and go
  RED.OLD_ABORT @ ABORT !  % back in STOIC: ABORT as before
  ;

'REDCPU :
  TIME_FLAG 1+! WORD .RED
  ; IMMEDIATE

> DEFINITIONS  % reset definitions to normal KERNEL branch
RED<  % push RED vocabulary again

'RED :
  SPACE_FLAG -1<-  % allow <SPACE> and <TAB> as commands
  WORD .RED  % get the file name from the line buffer
  ; IMMEDIATE

'RED_NOSP :
 SPACE_FLAG 0<-  % don't allow <SPACE> and <TAB> as commands
  WORD .RED  % and do normal RED
  ; IMMEDIATE

'REDOUT :  % called from STOIC to terminate RED
  D.START @ .D !  % reset data pointer to first dynast pointer
  0 FILE_NAME W!  % reset file name string
  E.RESET_CHARS  % reset to user's DCL terminal characteristics
  RESET_TERMINAL WAIT_FOR_RESET  % and reset the VT100
  ;

>  % pop the RED vocabulary

;F
