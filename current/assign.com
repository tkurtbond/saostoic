$ PREFIX := 'F$LOGICAL("SYS$DISK")'
$ PREFIX := 'PREFIX''F$DIRECTORY()'
$ LM1 = 'F$LENGTH(PREFIX)' - 1
$ PREFIX := 'F$EXTRACT(0,LM1,PREFIX)'
$ ASSIGN 'PREFIX'.KERNEL] SAO$KERNEL
$ ASSIGN 'PREFIX'.STOIC]  SAO$STOIC
$ ASSIGN 'PREFIX'.RED]    SAO$RED
$ STOIC :== $SAO$STOIC:STOIC
$ RED   :== $SAO$RED:RED RED
$ CALC  :== $SAO$RED:RED FLODEF
