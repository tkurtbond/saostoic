header .RCREATE
	bsbw	preopen
	jsbext	_rcreate
	rsbx

;----inch:  inch, pointer to current input channel
header INCH
	movl	u_ifi(r11),-(r10)
	rsbx

;----NEXTINCH:  NEXTINCH
;	increments input channel #
header NEXTINCH
	movq	u_ifi(r11),r0
	incl	r0
	cmpl	r0,r1
	bgtr	ni_err			;if table overflow
	movl	r0,u_ifi(r11)
	movl	r0,-(r10)
	rsbx
ni_err:	jsb	fatal
	string	</Input file table overflow./>

;----LASTINCH:  LASTINCH, inch
header LASTINCH
	decl	u_ifi(r11)		;decrement input file #
	blss	20$			;if index underflow
	brb	inch
20$:
	ret				;normal exit from STOIC
	wterm				;macro to terminate header

;----LOAD: file name, LOAD
header LOAD
	bsbw	nextinch
	bsbw	preopen
	jsbext	_open
	blbs	(r10),10$		;if it failed,
	decl	u_ifi(r11)		;give the input file back
10$:	jsb	syserr			;report a failure, and abort
	rsbx

;----CLOSE:  STOIC channel #, CLOSE
header CLOSE
	.extrn	_close
	jsb	_close
	jsb	syserr			;report a failure, and abort
	rsbx


;	File words with FRAB addresses on stack

;----FOPEN: file name, access byte, FRAB address, .FOPEN, condition code
header .FOPEN
	jsbext	_fopen
	rsbx

;----FCREATE: file name, access byte, FRAB address, .FCREATE, condition code
header .FCREATE
	jsbext	_fcreate
	rsbx

;----FCLOSE: FRAB address, .FCLOSE, condition code
header .FCLOSE
	jsbext	_fclose
	rsbx

;----FREAD: buffer address, length, FRAB address, .FREAD, condition code
header .FREAD
	jsbext	_fread
	rsbx

;----FWRITE: buffer address, length, FRAB address, .FWRITE, condition code
header .FWRITE
	jsbext	_fwrite
	rsbx

;----FGET: buffer address, length, FRAB, .FGET, not-end-of-file, cond. code
header .FGET
	jsbext	_fget
	rsbx

;----FPUT: buffer address, length, FRAB, .FPUT, condition code
header .FPUT
	jsbext	_fput
	rsbx

;----;F
header SEMIF,<;F>
	jsb	inch
	jsb	close
	jsb	lastinch
	tstl	(r10)+			;drop channel #
	rsbx

;----LOAD_reset:  LOAD_reset
;	cancels all active LOAD's, forcing input from console
header LOAD_RESET
	brb	20$
30$:
;...loop, closing out input files
	jsb	semif
20$:	tstl	u_ifi(r11)		;input file index
	bgtr	30$			;if not yet at console level
	rsbx

;----.GET:  buffer, len, chan, GET, ret. len, condition code
header .GET
	jsbext	_get
	rsbx

;----GET:  buffer, maxlen, chan, GET,
;	[ret. len., -1 (if not EOF)] or [0 (if EOF)]
header GET
	jsb	.get
	jsb	syserr
	blbs	(r10),20$		;if not EOF
	movl	(r10)+,(r10)		;EOF, don't return count
20$:	rsbx

;----GET_STRING:  string, chan, GETSTRING
header	GET_STRING
	jsbext	_rmsflush		;batch: put any partial output line
	movq	(r10),r2
	addl3	s^#2,r3,(r10)		;buffer address
	movzwl	-2(r3),-(r10)		;buffer length
	movl	r2,-(r10)		;channel
	pushl	r2			;keep the channel
	jsb	.get
	movl	(sp)+,r2
	tstl	r2			;the console?
	bneq	20$			;if not, just check
	blbs	(r10),10$		;if a console read failed,
	aoblss	#3,console_errs(r11),20$ ;count it; the third in a row
	movl	(r10),r0		;ends STOIC, with its status
	$exit_s	code=r0
10$:	clrl	console_errs(r11)	;a good read: start again
20$:	jsb	syserr
	movq	(r10)+,r0
	cvtlw	r1,@(r10)+		;return count
	movl	r0,-(r10)		;eof code
	rsbx

;----.PUT:  buffer, maxlen, chan, .PUT, condition code
header .PUT
	jsbext	_put
	rsbx

;----PUT:  buffer, maxlen, chan, PUT
header PUT
	jsb	.put
	jsb	syserr
	rsbx

;----RANDOGET: record #, buffer, length, chan., RANDOGET,-
;	returned length, condition code
	.extrn	_randoget
header RANDOGET
	jsb	_randoget
	rsbx

;----RANDOPUT: record #, buffer, length, RANDOPUT,condition code
header RANDOPUT
	.extrn	_randoput
	jsb	_randoput
	rsbx

newpage <READLINE, PROMPT>
;----READLINE:  % READLINE, not(eof)
;    reads a line into line buffer from current input device
header	I_READLINE
	addl3	prompt(r11),#5,r0	;get addr of check in prompt
	addb3	#^a/0/,check(r11),(r0)	;put check in prompt msg.
	movl	line_buffer(R11),-(R10)	;line buffer
	jsb	inch			;input channel
	jsb	get_string
	movl	line_buffer(r11),-(r10)
	bsbw	count
	movq	(r10)+,rest_of_line(r11);initial count
	clrl	@word_buffer(R11)	;null current word
	rsbx

;----NEWPROMPT:  string pointer, NEWPROMPT
;	install console prompt string
header NEWPROMPT
	movl	(r10),prompt(r11)	;install in user table
	jsb	count
	jsbext	_prompt			;install in FAB
	rsbx

;	start remote listener
header	REMSTART
	jsbext	_remstart
	jsb	syserr
	rsbx

;	type to remote port
header	REMTYPE
	jsbext	_remtype
	jsb	syserr
	rsbx

newpage <WORD>
;----WORD:  WORD, pointer to next word, success (fails if no more words)
header WORD
	movq	rest_of_line(r11),r0	;descriptor of rest of line
20$:
;...skip leading blanks, tabs, and form feeds
	movq	r0,r2			;save current position
	skpc	#^a/ /,r0,(r1)		;skip blanks
	skpc	#^x9,r0,(r1)		;skip tabs
	skpc	#^xC,r0,(r1)		;skip form feeds
	cmpl	r0,r2			;get any this time?
	bneq	20$			;yes, try to get more
					;2<length of line with word
					;3->beginning of word

;...leading double quote indicates string literal
	skpc	#^a/"/,r0,(r1)
	cmpl	r0,r2			;was there a leading /"/
	beql	30$			;no
	locc	#^a/"/,r0,(r1)
	skpc	#^a/"/,r0,(r1)
	brb	40$			;resume normal processing
30$:
;...leading percent sign indicates comment
	skpc	#^a/%/,r0,(r1)
	cmpl	r0,r2			;was there a leading /%/
	beql	35$			;no
	locc	#^a/%/,r0,(r1)
	skpc	#^a/%/,r0,(r1)
	brb	20$			;ignore comment
35$:
;...find end of normal word
	locc	#^a/ /,r0,(r1)		;find trailing space
	movq	r0,r4			;save result
	locc	#9,r2,(r3)		;find trailing tab
	cmpl	r0,r4			;which came first
	bgtr	40$			;if tab won
	movq	r4,r0			;restore
40$:
					;0,1>descriptor of rest of line
	movq	r0,rest_of_line(r11)
	subw2	r0,r2			;length of word
	bneq	50$			;if not end of line
	clrl	-(r10)			;signal failure
	rsb
50$:

;make word a STOIC string, place results on p-stack
	movl	word_buffer(r11),r4	;address of word buffer
	movw	r2,(r4)+		;length of word
	movl	r4,-(r10)
	movl	r2,-(r10)		;push string descriptor
	movc3	r2,(r3),(r4)		;move string
	movl	#1,-(r10)		;push true
	rsbx
newpage <COUNT, TYPE, MSG, TYI, TYO>
;----COUNT:  string pointer, COUNT, string address, string length
header COUNT
	movzwl	@(r10),-(r10)		;push count
	addl2	#2,4(r10)		;bump pointer
	rsbx

;----TYPE:  string address, string length, TYPE
;	outputs string to console
;header TYPE
;	.extrn	_type
;	jmp	_type
;	rsbx

;----TYPE: uses routine in TYPEADDR
header TYPE
	jmp	@typeaddr(r11)
	wterm

;Specialized type routines (RMSTYPE is necessary for batch jobs; either
;will work interactively but QIOTYPE is cheaper
header RMSTYPE
	jsbext	_rmstype
	rsbx
header QIOTYPE
	jsbext	_type
	rsbx

;----MSG:  string pointer, MSG
;    outputs string to console
header MSG
	jsb	count
	jsb	type
	rsbx

;----TYI:  TYI, byte
;	reads byte from console
header TYI
	.extrn	_tyi
	jsb	_tyi
	jsb	syserr
	rsbx

;----TYPE_GETLINE: buffer address, count, TYPE_GETLINE, count of bytes transferred
;	reads a line from the console using a QIO
header TYPE_GETLINE
	jsbext	_type_getline
	jsb	syserr
	rsbx

;----TYPE_TYI: performs TYPE and TYI efficiently
header TYPE_TYI
	jsbext	_type_tyi
	jsb	syserr
	rsbx

;----TYO:  byte, TYO
;    outputs byte to console
;header TYO
;	.extrn	_tyo
;	jsb	_tyo
;	jsb	syserr
;	rsbx

;----TYO: byte, TYO: calls routine whose address is in TYOADDR
header TYO
	jsb	@tyoaddr(r11)
	rsb

header RMSTYO
	jsbext	_rmstyo
	rsbx
header QIOTYO
	jsbext	_tyo
	rsbx

;----IO_CTRL_C: io_ctrl_c, [-1 if last I/O operation was interrupted
;    by ^C, 0 otherwise]
header IO_CTRL_C
	jsbext	_io_ctrl_c
	rsbx

;----GETMODE:  address of characteristics block, GETMODE
header GETMODE
	jsbext	_getmode
	jsb	syserr
	rsbx

;----SETMODE:  address of characteristics block, SETMODE
header SETMODE
	jsbext	_setmode
	jsb	syserr
	rsbx

;----CR:  CR
;    outputs a carriage return to console
header CR
	movl	#^xd,-(r10)		;push ASCII carriage return
	jsb	tyo			;output it
	movl	#^xA,-(r10)		;push ASCII line feed
	jsb	tyo			;output it
	rsbx

;----SPACE:  SPACE
;    outputs a space character to console
header SPACE
	movl	#^a/ /,-(r10)		;push ASCII space
	jsb	tyo			;output it
	rsbx

;----equal:  integer, EQUAL
;    converts integer to output string and types it.
header EQ_SGN,<=>
;	r0 - magnitude of number
;	r1 - 0 (high order part of dividend)
;	r2 - extracted digit
;	r3 - signed number
;	r4 - radix
;	r5 - string pointer
jsb	space
	movl	u_rad(r11),r4
	movl	r9,r5			;5<string pointer
	movl	(r10)+,r3		;3<signed #
	clrl	r1			;clear high part of dividend
	movl	r3,r0
	bgeq	20$			;if #<0
	mnegl	r3,r0			;0<abs(#)
20$:
	ediv	r4,r0,r0,r2		;0<quotient
					;2<raw digit
	cmpl	r2,#10			;convert to num. of alph.?
	bgeq	30$			;if alph.
	addb3	#^a/0/,r2,-(r5)		;convert & prefix to string
	brb	40$
30$:					;here on alph.
	addb3	#^a/A/-10,r2,-(r5)	;convert and prefix to string
40$:					;any more digits?
	tstl	r0			;any more digits?
	bgtr	20$			;if more digits
	tstl	r3			;test sign
	bgeq	50$			;if not negative
	movb	#^a/-/,-(r5)		;prefix minus
50$:
	movl	r5,-(r10)		;push string location
	subl3	r5,R9,-(r10)		;push length
	jsb	type			;output #
	rsbx

;----SHOW_TIME: 64-bit date, SHOW_TIME
header SHOW_TIME
	tstl	(r10)			;is the time non-zero?
	bneq	10$
	tstl	4(r10)
	bneq	10$
	brb	20$			;if zero, say kernel
10$:	cvtbl	#^x17,@time_string(r11)	;put length in descriptor
	$asctim_s	timbuf=@time_string(r11),timadr=(r10)+	;get the time
	.errstop
	movq	@time_string(r11),-(r10) ;push address, length
	bsbw	type			;type the time string
	rsb
20$:	addl2	#8,r10			;pop the time longwords
	moval	time_kernel,-(r10)
	bsbw	msg
	rsbx

	.psect	datinit

i_time_string:				;string descriptor
	.long	^x17			;string size is 23
	.long	i_time_string+8		;string address
	.blkb	^x17

	.psect	kernel

;----ENABLE_CTRL_C

enab_ctrl_c:
	pushal	ctrl_c_temp(r11)
	pushal	here_on_ctrl_c
	.extrn	enable_ctrl_c
	calls	#2,enable_ctrl_c
	rsb

	.entry	here_on_ctrl_c,^m<r2,r3,r4,r5,r6,r7,r8,r9,r10>
	movl	4(ap),r6		;get the address of the arg block
	subl3	#ctrl_c_temp,r6,r11	;set up R11
	mnegl	#1,ctrl_c_flag(r11)
	movl	ctrl_c_handler(r11),r0  ;address of handler
	beql	10$			;if no handler
	jsb	(r0)
10$:
	ret

header	I_CTRL_C_HNDLR			;initial control_c handler
;	causes an abort on control_c.  It finds the frame called from
;	STOIC's own.  If that is the AST routine's (STOIC code was
;	interrupted), it changes the PC in the AST's argument list, so
;	that the AST ends normally, through $ASTEXIT, and its REI lands
;	in ABORT (defect 2: it changed the AST routine's return PC, so
;	the process stayed at AST level).  If a called routine was
;	interrupted, it changes that routine's return PC.
	movl	fp,r0			;get frame pointer
20$:	cmpl	^xc(r0),r_stack_0(r11)
	beql	40$			;found stoic frame
	bgtr	60$			;if cannot find STOIC frame
	movl	^x0c(r0),r0		;get next frame
	brb	20$			;go try it
40$:					;here on frame found
	cmpl	r0,^x0c(fp)		;the AST routine's frame?
	bneq	50$			;if not, a called routine's
	movl	8(fp),r1		;1->AST argument list (astprm,
	moval	i_abort,16(r1)		;R0, R1, PC, PSL): its PC
	brb	60$
50$:	moval	i_abort,^x10(r0)	;force abort
60$:
	rsbx

;----OCONSTACK:  OCONSTACK, pointer to output conversion stack
header OCONSTACK
	movl	out_conv_stack(r11),-(r10)
	rsbx
newpage <Constant>
;----CONSTANT: value, name, CONSTANT
;	compiles longword constant
header CONSTANT
	movzbl	#4,-(r10)		;word length is 4
	movzbl	#push_this_word,-(r10)	;set up attribute byte
	jsb	@enter(r11)
	movl	code_pntr(r11),r0	;r0<dictionary pointer
	movl	(r10)+,(r0)+		;push value onto dictionary
	movl	r0,code_pntr(r11)
	rsbx

;----DATA_ADDRESS: value, name, DATA_ADDRESS, compiles address
;    relative to data pointer (r11)
header DATA_ADDRESS
	movzbl	#4,-(r10)		;word length is 4 for now
	movzbl	#disp_to_r11,-(r10)	;attribute byte
	jsb	@enter(r11)
	movl	code_pntr(r11),r0	;r0<dictionary pointer
	subl3	r11,(r10)+,(r0)+	;push displacement onto dictionary
	movl	r0,code_pntr(r11)
	rsbx
newpage <System stuff>
;----SYSTEM_SERVICES:  SYSTEM_SERVICES,
;	pointer to system services dictionary branch
header SYSTEM_SERVICES
	.extrn ss_calls
	movl	ss_calls,-(r10)
	rsbx

;-----MOAT:  MOAT, address of moat before parameter stack
header MOAT
	subl3	#^x200,p_stack_0(r11),-(R10)
	rsbx

;----P_STACK:  P_STACK, address of parameter stack
;	(also address of moat between P-stack & L-stack)
header P_STACK
	movl	p_stack_0(r11),-(r10)
	rsbx

;----L_STACK:  L_STACK, address of loop stack
;	(also address of moat between P-stack & L-stack)
header L_STACK
	movl	l_stack_0(r11),-(r10)
	rsbx

;----F_STACK:  F_STACK, address of floating point stack
;	(also address of moat between F-stack and V-stack)
header F_STACK
	moval	f_stack_0(r11),-(r10)
	rsb

;----V_STACK:  V_STACK, address of vocabulary stack
;	(also address of moat after V-stack)
header V_STACK
	movl	v_stack_0(r11),-(r10)
	rsbx

	newpage <Memory Management>
;----B,:  byte, B,
;    append byte to end of dictionery
header BCOMMA,<B,>
	movl	code_pntr(r11),r0	;r0->end of dictionary
	cvtlb	(r10)+,(r0)+		;append byte to dictionary
	movl	r0,code_pntr(r11)	;restore pointer
	rsbx

;----,:  value, ,
;    append value to end of dictionery
header COMMA,<,>
	movl	code_pntr(r11),r0	;r0->end of dictionary
	movl	(r10)+,(r0)+		;append to dictionary
	movl	r0,code_pntr(r11)	;restore pointer
	rsbx

;----ISOLATE_BLOCK:  accepts number of pages in R0
;    reserves that many pages with a moat before them
;    returns first usable address of new region in R1, first
;    unusable address in r2
header ISOLATE_BLOCK
	jsbext	get_block			;get pages
	rsbx					;and return

	newpage <Vocabulary Branches>

;----BRANCH:  pointer to branch header, name, BRANCH
;	creates a new vocabulary branch
header	BRANCH
	movl	#4,-(r10)		;code length is one longword
	movzbl	#push_vocab,-(r10)	;attribute
	jsb	@enter(r11)
	movl	code_pntr(r11),r0	;keep the branch pointer's displacement
	subl3	r11,(r10)+,(r0)+	;from r11, not its address (defect 22)
	movl	r0,code_pntr(r11)
	rsbx

;compile "addl3 r11,@#disp,-(r10)", the branch pointer's address now
header	I_PUSH_VOCAB
	movl	comp_buf_pntr(r11),r0
	movb	#op_addl3,(r0)+
	movb	#^x5b,(r0)+		;r11
	movb	#op_absolute,(r0)+	;@#
	movl	(r10)+,(r0)+		;the displacement in the definition
	movb	#op_auto_dec,(r0)+	;-(r10)
	movl	r0,comp_buf_pntr(r11)
	movl	#v_push,-(r10)
	jsb	i_jump_to_me
	rsbx

;----V_PUSH:
header V_PUSH
	movl	vocab_sp(r11),r0	;r0<vocabulary stack pointer
	movl	(r10)+,-(r0)		;push branch onto V-stack
	movl	r0,vocab_sp(r11)	;restore vocabulary-stack pointer
	rsbx

;---->:  pops the top off the V-stack
header LEFT_ANGLE,^!>!
	addl3	#8,vocab_sp(r11),r0	;would this pop the last branch?
	cmpl	r0,v_stack_0(r11)
	bgtru	vs_err			;if so, refuse
	addl2	#4,vocab_sp(r11)
	rsbx
vs_err:	jsb	fatal
	string	</Vocabulary stack empty./>

;----DEFINITIONS:  makes current the branch at top of V-stack
header DEFINITIONS
	movl	@vocab_sp(r11),current(r11)
	rsbx

;----ASSEMBLER<:  pushes pointer to ASSEMBLER branch onto V-stack
header ASSEMBLER_LA,^!ASSEMBLER<!
	movl	vocab_sp(r11),r0
	moval	assembler(r11),-(r0)
	movl	r0,vocab_sp(r11)
	rsbx

;----STOIC<:  pushes pointer to STOIC branch onto V-stack
header STOIC_LA,^!STOIC<!
	movl	vocab_sp(r11),r0
	moval	stoic(r11),-(r0)
	movl	r0,vocab_sp(r11)
	rsbx
;----TTIO<:  pushes TTIO vocabulary onto V-stack
header TTIO_LA,^!TTIO<!
	moval	ttio(r11),-(r10)
	bsbw	v_push
	rsbx
;----FLOAT<: pushes run-time library vocabulary onto V-stack
; (vocabulary named CRTL with code in that module)
header FLOAT_LA,^!FLOAT<!
	moval	float(r11),-(r10)
	bsbw	v_push
	rsbx

newpage	<Table Macros>

	.macro newtab			;start a new table
	table_offset=0
	.endm

	.macro dlrte	name,init=0,?p1	;macro to defin a longword
					;(address relative to R11)
	name==table_offset-^x8000	;table entry, sets name to
	foo=.				;remember this address
	.long init			;name and initial value to init
	table_offset=table_offset+4
	.save				;remember where we were

	.psect kernel			;and make a stoic word
	header p1,name,disp_to_r11	;that will execute the code
	.long name			;set up displacement
	.restore
	.endm

	.macro dlte	name,init=0,?p1	;macro to defin a longword

	name==table_offset		;table entry, sets name to
	foo=.				;remember this address
	.long init			;name and initial value to init
	table_offset=table_offset+4
	.save				;remember where we were

	.psect kernel			;and make a stoic word
	header p1,name,push_this_word	;that will push the address
	.long foo
	.restore
	.endm

	newpage <Table Definitions>

	.psect datinit
;user table

ut_start::	newtab
	dlrte	ADDRESS_STORAGE		;space for mem. management data
	.long	1			;leave space for two longwords
	table_offset=table_offset+4	;and adjust offset
	.global	address_storage		;make it available
	dlrte	COND_HANDLER,i_cond_handler
	dlrte	CTRL_C_TEMP		;terminal channel for control-c
	.long	1			;temporary for control-c
	table_offset=table_offset+4	
	dlrte	CTRL_C_FLAG		;flag which is set on control-c
	dlrte	CTRL_C_HANDLER,i_ctrl_c_hndlr
	dlrte	P_STACK_0		;initial p stack pointer
	dlrte	R_STACK_0		;initial return stack pointer
	dlrte	L_STACK_0		;initial loop stack pointer
	dlrte	F_STACK_0		;initial floating point stack ptr
	dlrte	V_STACK_0		;initial vocab stack pointer
	dlrte	FRAME_0			;initial frame pointer
	dlrte	VOCAB_SP		;vocabulary stack pointer
	dlrte	OUT_CONV_STACK		;output conversion stack
.list me
	dlrte	ASSEMBLER,<^x7fffffff>	;ASSEMBLER dictionary branch
	dlrte	STOIC,<^x7fffffff>	;STOIC branch
	dlrte	TTIO,ttio_ttio-dict_start-^x8000	;TTIO branch
	dlrte	FLOAT,crtl_crtl-dict_start-^x8000
.nlist me
	dlrte	DISPATCH_ADR,lookup_dispatch	;pntr to dispatch table
	dlrte	LOOKUP,i_lookup
	dlrte	COMPILE,i_compile
	dlrte	COMP_BUF_0
	dlrte	COMP_BUF_PNTR		;compile buffer pointer
	dlrte	END_OF_CMND		;compile end of command
	dlrte	END_OF_LINE		;compile end of line
	dlrte	CHECK			;if level
	dlrte	EXECUTE,i_execute	;execute word
	dlrte	LITERAL,i_literal	;literal handler
	dlrte	ERRCHK,i_errchk		;error checker
	dlrte	READLINE,i_readline
	dlrte	ABORT,i_abort
	dlrte	ERROR_PC		;pc saved by condition handler
	dlrte	COND_CODE		;conition code from error handler
	dlrte	COMPILE_ERROR,i_compile_error
	dlrte	DATE,0			;revision date for checking of
	table_offset=table_offset+4	;save files (quadword)	
	.long	0
	dlrte	DATE_ERROR,i_date_error		;address of date error routine
	dlrte	TIME_STRING
	dlrte	ENTER,i_enter
	dlrte	CODE_PNTR,dictionary	;code pointer
	dlrte	DICT_PNTR,dict_cur	;dictionary pointer
	dlrte	DICT_BASE,dict_start+^x8000
	dlrte	USER_DICTIONARY,<<^x200*<dict_cur/^x200>>+^x200>
	dlrte	USER_CODE,<<^x200*<dictionary/^x200>>+^x200>
	dlrte	DICT_0,dict_start
	dlrte	CODE_0,k_start
	dlrte	DATA_0,dat_start	;data prototype address
	dlrte	DATA_END,dat_fin
	dlrte	USER_DATA
	dlrte	VARIABLE_LIST		;list for var initialization
	dlrte	B_KERNEL,last_kernel-dict_start-^x8000	;kernel beginning
	dlrte	B_GLOBAL,last_global-dict_start-^x8000	;global beginning
	dlrte	CURRENT			;current dictionary branch
	dlrte	GLOBAL
	dlrte	PROMPT			;address of prompt string
	.blkl	1			;(2 longwords)
	table_offset=table_offset+4

	dlrte	USER_INIT,i_user_init		;user initializer

	dlrte	U_IFI			;input fab indexfab number
	dlrte	U_IFM,3			;max. fab #
	dlrte	U_IFT,channel_list ;file access table
	dlrte	LINE_BUFFER
	dlrte	REST_OF_LINE
	.long	0			;(this is a quadword entry)
	table_offset=table_offset+4
	dlrte	WORD_BUFFER
	dlrte	U_SGN			;sign for iliteral
	dlrte	U_MAG			;magnitude for iliteral
	.long
table_offset=table_offset+4		;this should be a quadword for fp
	dlrte	U_FLOAT			;flag for floating point
	dlrte	U_RAD,16		;radix
	dlrte	.D			;next free data location
	dlrte	.M			;first unavailable memory loc.
	dlrte	MSG_CHANNEL,4		;---RMS stuff---  message chan.
	dlrte	RANDOCHAN,5
	dlrte	BLK_CHAN,6
	dlrte	TYOADDR			;address of TYO routine
	dlrte	TYPEADDR		;address of TYPE routine
	dlrte	CHANNEL_LIST		;address of channel list
	dlrte	CMDDESC			;---SS stuff--- comm. desc.
	dlrte	TTNAME			;---TYIO stuff--- sys$command
	dlrte	TTCHAN			;entries for terminal channel
	.blkl	1			;2-longword entry for extra stuff
	table_offset=table_offset+4
	dlrte	NLEN,63			;device descriptor name field
	dlrte	NADDR			;address
	dlrte	NSTORE			;holding area for address
	dlrte	RMINAME
	.blkl	1
	table_offset=table_offset+4	;2 longword entry
	dlrte	RMICHAN
	.blkl	2
	table_offset=table_offset+8	;3 longword entry
	dlrte	RMONAME
	.blkl	1
	table_offset=table_offset+4	;2 longword entry
	dlrte	RMOCHAN
	.blkl	2
	table_offset=table_offset+8	;3 longword entry
	dlrte	RMBUF
	dlrte	CONSOLE_ERRS		;console read errors in a row
	dlrte	U_OVF			;iliteral: the magnitude overflowed
	dlrte	TT_IOSB			;terminal I/O status block
	.blkl	1			;(TTCHAN+2 overlapped NLEN)
	table_offset=table_offset+4

;	Size calculations for data prototype

u_cbp==comp_buf_pntr

lookup_dispatch::
	newtab				;lookup atribute bytes dispatch through here
	dlte	JUMP_TO_ME,i_jump_to_me	;compiles a jump to its arg
	dlte	IMMEDIATE,i_immediate	;execute at compile time
	dlte	COMPILE_BYTE,i_compile_byte	;compiles a byte
	dlte	PUSH_THIS_WORD,i_push_this_wd	;constant
	dlte	PUSH_VOCAB,i_push_vocab		;branch
	dlte	DISP_TO_R11,i_disp_to_r11	;variable, etc.

lt_length=.-lookup_dispatch

ut_end::
dat_end::

.save
.psect dictionary
.=kernel
last_kernel::
.=globlink
last_global::
.restore

.psect	kernel

newpage	<FINIS>

dictionary:

.psect	dictionary

dict_cur:


	.end start
