'C.J :  % journal
  O.K._TO_CLOSE? IF
    TOPOBOT D@- NOTE  % remember cursor position
    FILE_NAME COUNT CLI.REMVER  % file name without version #
    F.WRITE
    RECALL MOVE_DOWN DISP ELSE  % reset cursor position
