'CLI.SKIP_SARGS :  % number/args, CLI.SKIP_SARGS: throws away that many
  ( BEGIN  % loop to get rid of arguments
      CLI.GNB IF
        LFEED EQ_IF
          -1  % exit if line feed
        ELSE 0 THEN
      ELSE -1 THEN  % exit if no string
    END
  )
  ;

'POP_KBUF :  % return from executing buffer
  MSTACK DUP W@ + 1+ B@  % look at the return buffer number
  DUP 77 NE_IF  % is it the original value?
    DUP KBUF# ! 10 * K0 + CURKBUF !  % no, start executing there
    MSTACK DUP W@ + B@  % get the number of arguments
    MSTACK DUP W@ 6 - W<-  % pop the buffer stack
    CLI.SKIP_SARGS  % and skip over the arguments
    -1  % and return success
  ELSE
    DROP 0  % pop was done from K0; return fail
  THEN
  ;

