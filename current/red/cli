'C.L :  % move n lines
  C.ARG @ GTZ_IF  % get count
    UNDROP DUP CLI.MOVE_ERROR  % check for minor error
    C.L+ ELSE  % move n lines forward
    UNDROP MINUS 1+ C.L- THEN  % move 1-n lines backward
