$ SET NOON
$ SHOW SYMBOL MACRO
$ WRITE SYS$OUTPUT F$SEARCH("SYS$SYSTEM:MACRO32.EXE")
$ DIRECTORY/DATE/SIZE [.SAOSTOIC...]*.EXE,*.OBJ,*.MAP
$ ANALYZE/IMAGE/OUTPUT=ANA_SHIP_RKERNEL.TXT DUA1:[USERS.CLAUDE.SAOSTOIC.KERNEL]RKERNEL.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_SHIP_HEAD0.TXT DUA1:[USERS.CLAUDE.SAOSTOIC.KERNEL]HEAD0.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_SHIP_STOIC.TXT DUA1:[USERS.CLAUDE.SAOSTOIC.STOIC]STOIC.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_SHIP_RED.TXT DUA1:[USERS.CLAUDE.SAOSTOIC.RED]RED.EXE
$ DIRECTORY [.SAOSTOIC]*.EXE
$ EXIT 1
