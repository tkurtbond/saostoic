$ SET NOON
$ SET DEFAULT [.SAOSTOIC.KERNEL]
$ DIRECTORY/DATE=(CREATED,MODIFIED) *.MAR,*.OBJ
$ SET DEFAULT [--]
$ K = "[.SAOSTOIC.KERNEL]"
$ ANALYZE/OBJECT/OUTPUT=OLD_CONTROLC.ANL 'K'CONTROLC.OBJ;1
$ ANALYZE/OBJECT/OUTPUT=NEW_CONTROLC.ANL 'K'CONTROLC.OBJ;0
$ ANALYZE/OBJECT/OUTPUT=OLD_TYIO.ANL 'K'TYIO.OBJ;1
$ ANALYZE/OBJECT/OUTPUT=NEW_TYIO.ANL 'K'TYIO.OBJ;0
$ MACRO/LIST=CONTROLC.LIS/OBJECT=NL: 'K'CONTROLC
$ MACRO/LIST=TYIO.LIS/OBJECT=NL: 'K'TYIO
$ EXIT 1
