$ SET NOON
$ SET VERIFY
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT [.SAOSTOIC]
$ @STOBUILD MAC
$ SET DEFAULT SAO$RED
$ @HIREZ.CRE
$ SET DEFAULT 'HOME'
$ ANALYZE/IMAGE/OUTPUT=ANA_NEW_RKERNEL.TXT SAO$KERNEL:RKERNEL.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_NEW_STOIC.TXT SAO$STOIC:STOIC.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_NEW_RED.TXT SAO$RED:RED.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_NEW_REDHIREZ.TXT SAO$RED:REDHIREZ.EXE
$ ANALYZE/IMAGE/OUTPUT=ANA_SHIP_REDHIREZ.TXT DUA1:[USERS.CLAUDE.SAOSTOIC.RED]REDHIREZ.EXE
$ COPY SAO$KERNEL:RKERNEL.MAP []NEW_RKERNEL.MAP
$ DIRECTORY/DATE/SIZE [.SAOSTOIC...]*.EXE,*.OBJ,*.MAP,*.LIS
$ EXIT 1
