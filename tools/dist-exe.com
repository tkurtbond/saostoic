$!	DIST-EXE: make SAOSTOIC-CURRENT-EXE.ZIP in [.WORK] from the exes of
$!	[.WORK.CURRENT...] (built by PATCHED-BUILD), for a release.  It
$!	holds [.SAOSTOIC.KERNEL]HEAD0.EXE, [.SAOSTOIC.STOIC]STOIC.EXE and
$!	[.SAOSTOIC.RED]RED.EXE and REDHIREZ.EXE, zipped with ZIP "-V" so
$!	that UNZIP restores their record format.  Run by tools/vax-do:
$!	  tools/vax-do -o build/dist -get SAOSTOIC-CURRENT-EXE.ZIP tools/dist-exe.com
$!	ZIP and UNZIP are the symbols LOGIN.COM defines.
$ SET NOON
$ SET DEFAULT DUA1:[USERS.CLAUDE.WORK]
$ CREATE/DIRECTORY [.DIST.SAOSTOIC.KERNEL]
$ CREATE/DIRECTORY [.DIST.SAOSTOIC.STOIC]
$ CREATE/DIRECTORY [.DIST.SAOSTOIC.RED]
$ COPY [.CURRENT.KERNEL]HEAD0.EXE [.DIST.SAOSTOIC.KERNEL]
$ COPY [.CURRENT.STOIC]STOIC.EXE [.DIST.SAOSTOIC.STOIC]
$ COPY [.CURRENT.RED]RED.EXE,REDHIREZ.EXE [.DIST.SAOSTOIC.RED]
$ DIRECTORY/SIZE/DATE [.DIST.SAOSTOIC...]*.EXE
$ SET DEFAULT [.DIST]
$ ZIP "-V" [-]SAOSTOIC-CURRENT-EXE.ZIP [.SAOSTOIC...]*.EXE
$ SET DEFAULT [-]
$ UNZIP -l SAOSTOIC-CURRENT-EXE.ZIP
$ DELETE [.DIST.SAOSTOIC.*]*.*;*
$ SET PROTECTION=O:RWED [.DIST.SAOSTOIC]*.DIR;*
$ DELETE [.DIST.SAOSTOIC]*.*;*
$ SET PROTECTION=O:RWED [.DIST]*.DIR;*
$ DELETE [.DIST]*.*;*
$ SET PROTECTION=O:RWED DIST.DIR;1
$ DELETE DIST.DIR;1
$ EXIT 1
