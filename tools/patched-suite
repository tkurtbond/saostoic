#!/bin/sh
# Runs a suite against the Phase 6 patched build in [.WORK.PATCHED...]:
#
#   tools/patched-suite [--fix | --cmp] [--shipped] [--update] [<name>...]
#
# Without --fix: the regression suite tests/*, compared with
# tests/patched/*.expected. With --fix: the defect tests tests/fix/*,
# compared with tests/fix/patched/*.expected, or with --shipped run on the
# shipped STOIC.EXE and RED.EXE (only the tests that have a result there)
# and compared with tests/fix/shipped/. With --cmp: the boundary tests
# tests/cmp/*, which name no comparison word, compared with
# tests/cmp/patched/*.expected. Other
# arguments go to tools/stoic-suite. The build's date is masked.
#
# STOIC_TREE names another tree, such as cmpfix: its exes in
# [.WORK.CMPFIX...] are run, the tests' [.WORK.PATCHED...] paths are
# changed to it, and the results are compared with tests/cmpfix/,
# tests/fix/cmpfix/ and, since they must not change, tests/cmp/patched/.
# For cmpfix the helpers in tests/files/ (UTIL.STO's .S) are swapped by
# tools/cmp-swap so that they work as before. So are its tests, apart
# from 02-compare, 12-float and F15-DGE, which test the comparison words
# themselves, and F28-HEAD0, which LOADs IMAGE into the rebuilt STOIC:
# every other result must be the patched one.
here=$(cd "$(dirname "$0")" && pwd)
t=$here/../tests
tree=${STOIC_TREE:-patched}
TREE=$(echo "$tree" | tr a-z A-Z)
exe=DUA1:[USERS.CLAUDE.WORK.$TREE.STOIC]STOIC.EXE
red=DUA1:[USERS.CLAUDE.WORK.$TREE.RED]RED.EXE
fix= shipped= cmp=
# the build time changes with every build (REVISION, and rdef's XLOAD date
# error)
STOIC_SUITE_SED=${STOIC_SUITE_SED:-'s/^REVISION .*/REVISION (build time)/;s/^Date for this version:.*/Date for this version:	(build time)/'}
export STOIC_SUITE_SED
while :; do
  case $1 in
    --fix) fix=yes; shift ;;
    --cmp) cmp=yes; shift ;;
    --shipped) shipped=yes; shift ;;
    *) break ;;
  esac
done
# a copy of a test directory with its paths changed to the tree
treedir() {
  if [ "$tree" = patched ]; then echo "$1"; return; fi
  d=${TMPDIR:-/tmp}/stoic-$tree-$(basename "$1")
  rm -rf "$d"; mkdir -p "$d"
  for f in "$1"/*.sto "$1"/*.con "$1"/*.dcl "$1"/*.STO; do
    [ -f "$f" ] || continue
    n=$(basename "$f"); n=${n%.*}
    case $tree/$n in
      # F28 LOADs IMAGE into a STOIC of the old comparisons; keep its source
      cmpfix/F28-HEAD0) cp "$f" "$d/" ;;
      *) sed "s/WORK\.PATCHED/WORK.$TREE/g" "$f" > "$d/$(basename "$f")" ;;
    esac
    case $tree/$n in
      # these test the comparison words themselves; the rest only use them
      cmpfix/02-compare|cmpfix/12-float|cmpfix/F15-DGE|cmpfix/F28-HEAD0) ;;
      cmpfix/*) "$here/cmp-swap" "$d/$(basename "$f")" >&2 ;;
    esac
  done
  echo "$d"
}
# tests/files, or for cmpfix a copy with its comparisons swapped
filesdir() {
  if [ "$tree" != cmpfix ]; then echo "$t/files"; return; fi
  d=${TMPDIR:-/tmp}/stoic-$tree-files
  rm -rf "$d"; cp -r "$t/files" "$d"
  "$here/cmp-swap" "$d"/* >&2
  echo "$d"
}
F=$(filesdir)
if [ -n "$cmp" ]; then
  exec "$here/stoic-suite" -x "$exe" -r "$red" -F "$F" -d "$(treedir "$t/cmp")" -e "$t/cmp/patched" "$@"
fi
if [ -n "$fix" ]; then
  if [ -n "$shipped" ]; then
    # only the tests with a shipped result: F24 would loop for ever
    if [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --update ]; }; then
      set -- "$@" $(cd "$t/fix/shipped" && ls *.expected | sed 's/\.expected$//')
    fi
    exec "$here/stoic-suite" -d "$t/fix" -e "$t/fix/shipped" "$@"
  fi
  mkdir -p "$t/fix/$tree"
  exec "$here/stoic-suite" -x "$exe" -r "$red" -F "$F" -d "$(treedir "$t/fix")" -e "$t/fix/$tree" "$@"
fi
mkdir -p "$t/$tree"
exec "$here/stoic-suite" -x "$exe" -r "$red" -F "$F" -d "$(treedir "$t")" -e "$t/$tree" "$@"
