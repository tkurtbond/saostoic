#!/bin/sh
# Copies the patched sources to the VAX: every file under patched/ that
# differs from saostoic-text/ (or the ones named) goes by ASCII FTP, in
# one session, to its place in DUA1:[USERS.CLAUDE.WORK.PATCHED...]
# (patched/kernel/rkernel.mar to [.WORK.PATCHED.KERNEL]RKERNEL.MAR,
# patched/stoic/rdef to [.WORK.PATCHED.STOIC]RDEF.). Each copy is a new
# version there. tools/setup-patched.com must have made the tree.
#
#   tools/patched-push [-n] [<patched/file>...]
#
#   -n   list what would be copied, and copy nothing
set -e
here=$(cd "$(dirname "$0")" && pwd)
top=$here/..
host=${VAX_HOST:-192.168.2.20}
netrc=${VAX_NETRC:-$HOME/.netrc-claude-vax}
dry=
[ "$1" = -n ] && { dry=yes; shift; }
cd "$top"
if [ $# -eq 0 ]; then
  set -- $(find patched -type f | sort | while read -r f; do
    cmp -s "$f" "saostoic-text/${f#patched/}" || echo "$f"; done)
fi
[ $# -gt 0 ] || { echo "patched-push: nothing differs"; exit 0; }
args=
for f; do
  case $f in patched/*) ;; *) echo "patched-push: $f is not under patched/" >&2; exit 2 ;; esac
  [ -f "$f" ] || { echo "patched-push: no $f" >&2; exit 2; }
  rel=${f#patched/}
  d=$(dirname "$rel"); n=$(basename "$rel" | tr a-z A-Z)
  case $n in *.*) ;; *) n=$n. ;; esac
  # absolute, since each CWD in the one session is from the last
  if [ "$d" = . ]; then dir=DUA1:%5BUSERS.CLAUDE.WORK.PATCHED%5D
  else dir=DUA1:%5BUSERS.CLAUDE.WORK.PATCHED.$(echo "$d" | tr a-z A-Z)%5D; fi
  echo "$f -> $dir/$n"
  args="$args -T $f ftp://$host/$dir/$n"
done
[ -n "$dry" ] && exit 0
. "$here/vax-lock.sh"
vax_lock
trap vax_unlock EXIT
# shellcheck disable=SC2086
curl -sS --netrc-file "$netrc" -P - --use-ascii $args
