% 12-MATH: THE MATH WORDS OF CRTL.MAR.  EACH ONE-ARGUMENT WORD CALLS
% MTH$D<NAME> ON THE TOP OF THE FLOAT STACK; .POWDD CALLS OTS$POWDD.
FLOAT< DECIMAL
"SQRT    " MSG 2. .SQRT .= SPACE 16. .SQRT .= CR
"SIN COS " MSG 0. .SIN .= SPACE 0. .COS .= CR
"ATAN    " MSG 1. .ATAN 4. .* .= CR
"ASIN    " MSG 1. .ASIN 2. .* .= SPACE 1. .ACOS .= CR
"TAN     " MSG 1. .ATAN .TAN .= CR
"EXP LOG " MSG 1. .EXP .= SPACE 1. .EXP .LOG .= SPACE 1000. .LOG10 .= CR
"HYPER   " MSG 0. .SINH .= SPACE 0. .COSH .= SPACE 0. .TANH .= CR
% WHICH OPERAND IS THE BASE?
"POWDD   " MSG 2. 3. .POWDD .= SPACE 2. 3. .^ .= CR
% A DOMAIN ERROR OR OVERFLOW IN MTH$ OR OTS$ IS NOT REPORTED: THE ROUTINE
% RETURNS A RESERVED OPERAND, AND THE NEXT FLOAT WORD (HERE .=) FAULTS
"LOG 0   " MSG 0. .LOG .= CR
"POW OVF " MSG 10. 1000. .^ .= CR
"ASIN 2  " MSG 2. .ASIN .= CR
"NEXT LINE" MSG CR
% BUT THE SQUARE ROOT OF A NEGATIVE NUMBER ENDS STOIC WITH AN ACCVIO
% (IMPROPERLY HANDLED CONDITION), SO IT IS LAST
"SQRT -1 " MSG -1. .SQRT .= CR
"NOT REACHED" MSG CR
