$! BATCH JOB FOR TESTS/FIX/F08-BATCH.DCL: RUNS THE STOIC NAMED IN F08EXE.TMP
$! ON DATA LINES. EACH LINE IT PRINTS BEGINS WITH A DOUBLED LETTER Q, WHICH
$! NEITHER THIS FILE NOR THE LOG'S ECHO OF IT HAS, SO SEARCH CAN FIND THEM.
$ SET NOON
$ SET DEFAULT DUA1:[USERS.CLAUDE.WORK]
$ OPEN/READ F F08EXE.TMP
$ READ F X
$ CLOSE F
$ S := 'X'
$ S
DECIMAL
"Q" MSG "QA " MSG 1 2 + = CR
"Q" MSG "QB" MSG 4 = 5 = CR
"Q" MSG "QC" MSG 6 =
;F
$ EXIT
