FILL :== $DUA1:[USERS.CLAUDE.WORK]FILLRED.EXE
WRITE SYS$COMMAND "RUN FILLRED"
FILL HEX "LAST " MSG FS_LAST <#> TYPE "  GROUP " MSG <#> TYPE CR ;F
FILL HEX "CODE FREE=" MSG 0 R8@+ 8000 - 4032D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8000 - DICT_PNTR @ - <#> TYPE CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
