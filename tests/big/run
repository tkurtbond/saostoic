#!/bin/sh
# Runs the big-application test of Phase 7 (doc/image.md) and writes
# tests/big/results/:
#   load.txt  BIGAPP.STO LOADed on the patched RED.EXE, its total, where
#             it landed and the room left; then IMAGE as [.WORK]BIGRED.EXE,
#             and BIGRED run by command tails
#   r-big.*   the editor in BIGRED.EXE (tools/red-drive)
# tests/big/gen remakes BIGAPP.STO.
cd "$(dirname "$0")/../.." || exit 2
T=tests/big R=tests/big/results
# STOIC_TREE names another tree, such as current: its exes are run, and
# the results go to $R/<tree>/.
tree=${STOIC_TREE:-patched}
TREE=$(echo "$tree" | tr a-z A-Z)
if [ "$tree" != patched ]; then
  R=$R/$tree
  P=${TMPDIR:-/tmp}/stoic-$tree-image; mkdir -p $P
  for f in a1-pat.dcl e1-pat.dcl; do sed "s/PATCHED/$TREE/g" tests/image/$f > $P/$f; done
else
  P=tests/image
fi
mkdir -p $R
VAX_DO_TIMEOUT=1500 tools/stoic-run -m -f $T/BIGAPP.STO \
  -x "DUA1:[USERS.CLAUDE.WORK.$TREE.RED]RED.EXE" \
  $P/a1-pat.dcl $T/big1-load.con $T/big2-run.dcl > $R/load.txt 2>&1
echo "load: exit $?"
STOIC_RED='DUA1:[USERS.CLAUDE.WORK]BIGRED.EXE' tools/red-drive -o $R $T/r-big.tcl
echo "red: exit $?"
