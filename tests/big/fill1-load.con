% FILL1-LOAD: LOAD FILLAPP.STO ON THE PATCHED RED.EXE UNTIL THE CODE IS
% FULL, SHOW THE LAST GROUP THAT LOADED AND THE ROOM LEFT, TRY ONE MORE
% FAT WORD AND A SMALL ONE, IMAGE THE FULL RED AS FILLRED.EXE (THE SPARE
% PAGE AFTER K_END LEAVES ITS DZRO ONE PAGE), THEN FORGET HALF OF IT.
HEX
"BEFORE " MSG "CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
'FILLAPP.STO LOAD
"AFTER  " MSG "CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
"CODE FREE=" MSG 0 R8@+ 8000 - 4012D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8200 - DICT_PNTR @ - <#> TYPE CR
"LAST " MSG FS_LAST <#> TYPE "  GROUP " MSG <#> TYPE CR
'FS_LAST WHERE CR
'FAT : 039735A1C + 0234F069B + 042899387 + 06351D228 + 0162E3FE8 + 019459799 + 0791F8412 +
  05497C815 + 01C0C7408 + 03ECEE4FC + 05A98CC2E + 0176C823A + 050F3A77A + 02B7B3AE6 + 014CCA86C +
  01B0051AD + 04781B3AD + 04586AA4D + 018F105C7 + 02ECE0B92 + 01B9C7BEC + 05688B767 + 04656A513 +
  01790EEDB + 079D64A57 + 05860C967 + 01FD8BE11 + 02C93182C + 060B8599C + 0604FBB5A + 05A9FA478 +
  017EB1878 + 059DE8267 + 05AF3057A + 042C66D0A + 01658F14E + 02C4C68C8 + 015F66BD8 + 05740CB9F +
  07DE24B65 + 0210BDF56 + 03511EACB + 045A65921 + 02276F352 + 0553531F6 + 01F13D0E0 + 05913B32C +
  0377C551C + 057B682AC + 07876D417 + 0674BDD4A + 027220AC5 + 01D30EDF1 + 05A71DFC8 + 0591D39B4 +
  061C7EAA3 + 0280C2862 + 03FAAB901 + 01C789AE9 + 0561C7D94 + 06B267211 + 01809781B + 0583D3861 +
  017A102DA + 05F3BB4D8 + 02A5CDAEF + 04F8A8292 + 0671758AA + 0540F68B1 + 046BB583F + ;
"FAT DONE" MSG CR
"CODE FREE=" MSG 0 R8@+ 8000 - 4012D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8200 - DICT_PNTR @ - <#> TYPE CR
'TINY : 1 2 + ;
"TINY " MSG TINY = CR
"CODE FREE=" MSG 0 R8@+ 8000 - 4012D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8200 - DICT_PNTR @ - <#> TYPE CR
'FILLRED.EXE IMAGE
FILL_HALF FORGET
"FORGOT " MSG "CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
"CODE FREE=" MSG 0 R8@+ 8000 - 4012D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8200 - DICT_PNTR @ - <#> TYPE CR
"LAST " MSG FS_LAST <#> TYPE "  GROUP " MSG <#> TYPE CR
'AFTER_FORGET : FS_LAST + 1 + ;
"AFTER_FORGET " MSG AFTER_FORGET <#> TYPE CR
'AFTER_FORGET WHERE CR
