% BIG1-LOAD: LOAD THE GENERATED APPLICATION ON THE PATCHED RED.EXE, SHOW
% WHERE ITS WORDS LANDED AND THE ROOM LEFT, AND IMAGE IT AS BIGRED.EXE.
HEX
"BEFORE " MSG "CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
'BIGAPP.STO LOAD
"AFTER  " MSG "CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
"R8+7FFF=" MSG 0 R8@+ 7FFF + <#> TYPE "  CODE_0=" MSG CODE_0 @ <#> TYPE CR
"CODE FREE=" MSG 0 R8@+ 8000 - 4012D + CODE_PNTR @ - <#> TYPE "  DICT FREE=" MSG 0 R8@+ 8200 - DICT_PNTR @ - <#> TYPE CR
'APP_SUM_00 WHERE CR 'APP_SUM_36 WHERE CR 'APP_TOTAL WHERE CR
'BIGRED.EXE IMAGE
