% 02-COMPARE: COMPARISONS (RDEF:487-516).  CMPL (P)+ (P)+ COMPARES A WITH
% B, SO "B A GT" IS TRUE WHEN A > B, THE REVERSE OF STOIC.MEM.
DECIMAL
"      1 2  2 1  2 2 -1 1" MSG CR
"EQ  " MSG 1 2 EQ = 2 1 EQ = 2 2 EQ = -1 1 EQ = CR
"NE  " MSG 1 2 NE = 2 1 NE = 2 2 NE = -1 1 NE = CR
"GT  " MSG 1 2 GT = 2 1 GT = 2 2 GT = -1 1 GT = CR
"LT  " MSG 1 2 LT = 2 1 LT = 2 2 LT = -1 1 LT = CR
"GE  " MSG 1 2 GE = 2 1 GE = 2 2 GE = -1 1 GE = CR
"LE  " MSG 1 2 LE = 2 1 LE = 2 2 LE = -1 1 LE = CR
"      -1 0 1" MSG CR
"EQZ " MSG -1 EQZ = 0 EQZ = 1 EQZ = CR
"NEZ " MSG -1 NEZ = 0 NEZ = 1 NEZ = CR
"GTZ " MSG -1 GTZ = 0 GTZ = 1 GTZ = CR
"LTZ " MSG -1 LTZ = 0 LTZ = 1 LTZ = CR
"GEZ " MSG -1 GEZ = 0 GEZ = 1 GEZ = CR
"LEZ " MSG -1 LEZ = 0 LEZ = 1 LEZ = CR
% THE *_IF FORMS ARE IMMEDIATE AND COMPILE A COMPARE AND A BRANCH
'T2 : IF 1 ELSE 0 THEN = ;
"IF  " MSG 3 T2 2 T2 1 T2 0 T2 -1 T2 -2 T2 CR
'TEQ : EQ_IF 1 ELSE 0 THEN = ; 'TNE : NE_IF 1 ELSE 0 THEN = ;
'TGT : GT_IF 1 ELSE 0 THEN = ; 'TLT : LT_IF 1 ELSE 0 THEN = ;
'TGE : GE_IF 1 ELSE 0 THEN = ; 'TLE : LE_IF 1 ELSE 0 THEN = ;
"EQ_IF " MSG 1 2 TEQ 2 1 TEQ 2 2 TEQ CR
"NE_IF " MSG 1 2 TNE 2 1 TNE 2 2 TNE CR
"GT_IF " MSG 1 2 TGT 2 1 TGT 2 2 TGT CR
"LT_IF " MSG 1 2 TLT 2 1 TLT 2 2 TLT CR
"GE_IF " MSG 1 2 TGE 2 1 TGE 2 2 TGE CR
"LE_IF " MSG 1 2 TLE 2 1 TLE 2 2 TLE CR
'ZEQ : EQZ_IF 1 ELSE 0 THEN = ; 'ZNE : NEZ_IF 1 ELSE 0 THEN = ;
'ZGT : GTZ_IF 1 ELSE 0 THEN = ; 'ZLT : LTZ_IF 1 ELSE 0 THEN = ;
'ZGE : GEZ_IF 1 ELSE 0 THEN = ; 'ZLE : LEZ_IF 1 ELSE 0 THEN = ;
"EQZ_IF " MSG -1 ZEQ 0 ZEQ 1 ZEQ CR
"NEZ_IF " MSG -1 ZNE 0 ZNE 1 ZNE CR
"GTZ_IF " MSG -1 ZGT 0 ZGT 1 ZGT CR
"LTZ_IF " MSG -1 ZLT 0 ZLT 1 ZLT CR
"GEZ_IF " MSG -1 ZGE 0 ZGE 1 ZGE CR
"LEZ_IF " MSG -1 ZLE 0 ZLE 1 ZLE CR
% UNDROP AFTER EQ_IF GIVES BACK THE TOP VALUE (RDEF:229)
'TU : EQ_IF 0 ELSE UNDROP THEN ;
"UNDROP " MSG 2 3 TU = CR
"DGE " MSG 1 0 0 0 DGE = 0 0 1 0 DGE = 0 1 0 0 DGE = CR
% A QUAD IS PUSHED HIGH FIRST.  RIGHT ANSWERS: -1 (A, ON TOP, IS
% 2**32-1, >= B = 0) AND 0 (A = -2**32+3 < B = -2**32+5).  DGE
% COMPARES THE LOW LONGWORDS SIGNED, AND SWAPS THEM WHEN THE HIGH ONES ARE
% NEGATIVE, SO IT GIVES 0 AND -1 (DEFECT 15; THE PATCHED BUILD GETS -1 0).
"DGE LOW " MSG 0 0 0 -1 DGE = -1 5 -1 3 DGE = CR
