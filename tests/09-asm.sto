% 09-ASM: WORDS WRITTEN IN THE IN-LINE ASSEMBLER (RDEF ASSEMBLER<, STOIC
% DUPI).  VAX ORDER: THE OPCODE, THEN ITS OPERANDS; ";" ADDS THE RSB.
DECIMAL
ASSEMBLER<
'ADD2 : ADDL2 (P)+ (P) ;
'SECOND : MOVL B^(P) 4 -(P) ;
'FIVE : MOVL S^ 5 R0 MOVL R0 -(P) ;
'MYLTZ : TSTL (P)+ BLSS ITEFT ;
'INC : INLINE< INCL (P) >INLINE ; IMMEDIATE
'DEREF : MOVL @B^(P) 0 (P) ;
>
"ADD2    " MSG 3 4 ADD2 = CR
"SECOND  " MSG 1 2 SECOND = = = CR
"FIVE    " MSG FIVE = CR
"MYLTZ   " MSG -3 MYLTZ = 3 MYLTZ = 0 MYLTZ = CR
'T2 : 5 INC = ;
"INLINE  " MSG T2 CR
9 'VV VARIABLE
"DEREF   " MSG VV DEREF = CR
% OUTSIDE ASSEMBLER< THE OPCODES ARE NOT FOUND
% DUPI IS WRITTEN FOR HEX RADIX (BA IS ITS OPCODE BYTE)
HEX
"SAO$STOIC:DUPI." LOAD
DECIMAL
"DUPI    " MSG CR "ABC" TEST
"LAST    " MSG 'ADDL2 COUNT I_LOOKUP = CR
