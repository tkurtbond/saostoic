% 08-VOCAB: BRANCHES, DEFINITIONS, REDEFINITION, CONSTANTS, MODULE AND
% FORGET (RDEF BRANCH, MODULE, FORGET).  DEF? IS TRUE IF A WORD IS FOUND.
DECIMAL
'DEF? : COUNT I_LOOKUP IF DROP -1 ELSE 0 THEN ;
"LOOKUP  " MSG 'DUP DEF? = 'NOSUCH DEF? = CR
'TV< BRANCH
TV< DEFINITIONS
'HIDDEN : 111 = ;
> DEFINITIONS
"OUTSIDE " MSG 'HIDDEN DEF? = CR
% TV< TAKES EFFECT WHEN ITS LINE RUNS, AFTER THE LINE IS COMPILED: ON ITS
% OWN LINE A LOOKUP AT RUN TIME FINDS HIDDEN, BUT HIDDEN COMPILED THERE
% WOULD BE UNDEFINED, SO IT NEEDS A LINE OF ITS OWN
"SAME LINE " MSG TV< 'HIDDEN DEF? = > CR
TV<
"INSIDE  " MSG 'HIDDEN DEF? = HIDDEN CR
>
"AFTER > " MSG 'HIDDEN DEF? = CR
% A REDEFINITION'S BODY STILL SEES THE OLD WORD
'W1 : 1 = ;
'W1 : W1 2 = ;
"REDEF   " MSG W1 CR
42 'K CONSTANT
"CONST   " MSG K = CR
7 'V VARIABLE
"VAR     " MSG V @ = 9 V ! V @ = CR
3 'A3 ARRAY
"ARRAY   " MSG 11 A3 ! 22 A3 4+ ! 33 A3 8 + ! A3 @ = A3 4+ @ = A3 8 + @ = CR
'MARKER MODULE
'GONE : 5 = ;
"MODULE  " MSG 'GONE DEF? = MARKER FORGET 'GONE DEF? = 'MARKER DEF? = 'K DEF? = CR
"AFTER FORGET " MSG 'AGAIN : 6 = ;
AGAIN CR
% EXEC RUNS A WORD FROM ITS CODE ADDRESS; () GIVES THE ADDRESS
"EXEC    " MSG () AGAIN EXEC CR
