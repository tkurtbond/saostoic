% 06-NUMIO: RADIX, NUMBER INPUT AND OUTPUT (RDEF <# ... I=, RKERNEL
% DIGIT AND ILITERAL).  THE DEFAULT RADIX IS HEX.
"DEFAULT " MSG RADIX @ = CR
DECIMAL
"RADIX   " MSG RADIX @ = HEX RADIX @ = DECIMAL CR
% A LINE IS COMPILED BEFORE IT RUNS, SO A RADIX CHANGE GOVERNS ONLY THE
% LINES AFTER IT
"SAME LINE " MSG HEX 10 DECIMAL = CR
HEX
"HEX IN  " MSG 10 FF 0FF DECIMAL = = = CR
"HEX OUT " MSG 255 HEX = -1 = DECIMAL CR
8 RADIX !
"OCTAL   " MSG 777 DECIMAL = CR
2 RADIX !
"BINARY  " MSG 1011 DECIMAL = CR
"ASCII   " MSG ASCII A = ASCII 0 = CR
"<#>     " MSG 1234 <#> TYPE SPACE 0 <#> TYPE SPACE -56 <#> TYPE CR
"MININT  " MSG -2147483648 <#> TYPE CR
"PARTIAL " MSG 1234 <# # # #> TYPE CR
HEX
"#S HEX  " MSG BEEF <# #S #> TYPE DECIMAL CR
% I= PRINTS A SPACE FOR EACH LEADING ZERO, SO 0 IS ALL SPACES; IT KEEPS
% ONLY THE LOW DIGITS OF A NUMBER WIDER THAN THE FIELD, AND /MOD IS
% UNSIGNED, SO A NEGATIVE NUMBER PRINTS AS 2**32 LESS ITS MAGNITUDE
"I=      |" MSG 42 6 I= "|" MSG 0 3 I= "|" MSG 123456 3 I= "|" MSG CR
"I= NEG  |" MSG -42 6 I= "|" MSG CR
"LEADING " MSG 007 = -0 = CR
% A FLOAT IS READ AS DECIMAL EVEN IN HEX RADIX, BUT ITS CHARACTERS MUST
% BE DIGITS IN THE RADIX, SO AN EXPONENT WORKS ONLY IN HEX (E IS A DIGIT)
FLOAT<
HEX
"HEX FLT " MSG 10. .= SPACE 1.8 .= SPACE 1.E3 .= SPACE 2.5E1 .= DECIMAL CR
>
% INTEGER LITERALS ARE NOT CHECKED FOR OVERFLOW (THE PATCHED BUILD MAKES
% THIS A COMPILE ERROR, WHICH ENDS THE FILE HERE)
"BIG     " MSG 4294967296 = 4294967297 = 99999999999 = CR
HEX
"HEX BIG " MSG 123456789 DECIMAL = CR
% DIGIT TAKES ANY CHARACTER ABOVE "Z" FOR A DECIMAL POINT, SO IN A LOAD
% FILE (NOT UPPERCASED) A LOWERCASE WORD WITH ONE LETTER IS A FLOAT
% LITERAL AND COMPILES WITHOUT ERROR (THE PATCHED
% BUILD MAKES x UNDEFINED, WHICH ENDS THE FILE HERE)
FLOAT<
"LOWER   " MSG 5 x = .= SPACE 1x5 .= SPACE 2_5 .= SPACE 7[ .= CR
>
% TWO SUCH CHARACTERS MAKE THE WORD UNDEFINED, WHICH ENDS THE FILE
"LOWER 2 " MSG xy
"NOT REACHED" MSG CR
