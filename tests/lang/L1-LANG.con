% L1-LANG: LANGUAGE.MD CLAIMS CHECKED AT THE CONSOLE (PHASE 5)
DECIMAL
CR "C1 MID-LINE % COMMENT, EXPECT 3:" MSG 1 % COMMENT % 2 + = CR
"C2 %X% UNSPACED, EXPECT 3:" MSG 1 %X% 2 + = CR
"C4 NEGATIVE +LOOP STEP:" MSG 3 0 DO I = I -4 EQ IF 0 @ THEN -1 +LOOP
CR "C5 I AFTER EXIT, EXPECT 1:" MSG 5 0 DO I 2 EQ IF EXIT I = THEN LOOP CR
'M MODULE 7 'V VARIABLE M FORGET
1 'AR ARRAY
"C6 ARRAY AFTER FORGET:" MSG AR @ = CR
100 'N CONSTANT
200 () N !
"C7 () N !, EXPECT 200:" MSG N = CR
HEX 'AB : 99 ;
"C9 WORD SHADOWS NUMBER, EXPECT 99:" MSG AB DECIMAL = CR
'MX : DDUP GT IF DROP ELSE UNDER THEN ;
"C10 MANUAL MAX, 3 7:" MSG 3 7 MX = CR
"HELLO"
"C11 STRING FROM LAST LINE, COUNT:" MSG COUNT = DROP CR
"C13 : INSIDE IF:" MSG CR
1 IF 'X : 1 ; THEN
"END" MSG CR
