% F1-FLOAT: FLOAT.MD CLAIMS (PHASE 5)
FLOAT< DECIMAL
"+ROT:" MSG 1.1 2.2 3.3 .+ROT .= .= .= CR
"-ROT:" MSG 1.1 2.2 3.3 .-ROT .= .= .= CR
"F.EXPADD AFTER .=:" MSG 0 F.EXPADD ! 1.5 .= F.EXPADD @ = CR
"F_STACK, F_STACK @, L_STACK:" MSG F_STACK = F_STACK @ = L_STACK = CR
"E= .001 12 3:" MSG .001 12 3 E= CR
".<#> 1.5:" MSG 1.5 .<#> TYPE CR
".<#> -2.25:" MSG -2.25 .<#> TYPE CR
".EFIX 1234.5:" MSG 1234.5 .EFIX = .= CR
"SECOND POINT:" MSG CR
1.2.3 .= CR
"UNDERFLOW:" MSG CR
.DROP .DROP .= CR
"OVERFLOW:" MSG CR
'FILL : 70 0 DO 1. LOOP ;
FILL
"AFTER OVERFLOW" MSG CR
HEX
"HEX 1.A:" MSG 1.A .= CR
