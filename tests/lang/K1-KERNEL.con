% K1-KERNEL: KERNEL.MD CLAIMS (PHASE 5).  HEX RADIX.
"K1 R_STACK_0 - FRAME_0:" MSG R_STACK_0 @ FRAME_0 @ - = CR
"K2 JUMP_TO_ME IMMEDIATE:" MSG JUMP_TO_ME = IMMEDIATE = CR
'X : ;
"K3 ATTRIBUTE OF X:" MSG LOOKUP_ATTRIBUTE C@ = CR
"K4 PROMPT COUNT:" MSG PROMPT @ COUNT = DROP CR
"K5 MOAT P L V COMP_BUF_0:" MSG MOAT = P_STACK = L_STACK = V_STACK = COMP_BUF_0 @ = CR
"K6 F_STACK F_STACK_0 @:" MSG F_STACK = F_STACK_0 @ = CR
"K8 B, ADVANCES CODE_PNTR:" MSG CODE_PNTR @ = 5 B, CODE_PNTR @ = CR
"K10 BEFORE LOAD" MSG CR
'KA.STO LOAD "AFTER" MSG CR
"K11 SS ARGS:" MSG DEPTH = CR
"K13 DEF? $SCHDWK:" MSG '$SCHDWK DEF? = CR
"K15 USER_DATA:" MSG USER_DATA @ = CR
