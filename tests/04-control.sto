% 04-CONTROL: IF ELSE THEN, BEGIN END, BEGIN IF REPEAT, DO LOOP, +LOOP,
% "X 5 GT" IS TRUE WHEN X < 5: THE TOP IS COMPARED WITH THE ONE UNDER IT.
% I J K I' LAST_I EXIT, AND N ( ... ) (RDEF:520-555, 650-760).
DECIMAL
'T : IF "T" ELSE "F" THEN MSG ;
"IF        " MSG 1 T 0 T 3 T 2 T -1 T CR
'N : IF IF "TT" ELSE "TF" THEN ELSE IF "FT" ELSE "FF" THEN THEN MSG ;
"NESTED    " MSG 1 1 N SPACE 0 1 N SPACE 1 0 N SPACE 0 0 N CR
"IF ONLY   " MSG 1 IF "Y" MSG THEN 0 IF "N" MSG THEN CR
"BEGIN END " MSG 0 BEGIN DUP = 1+ DUP 5 EQ END DROP CR
"BEGIN ONCE" MSG 9 BEGIN DUP = 1 END DROP CR
"REPEAT    " MSG 0 BEGIN DUP 5 GT IF DUP = 1+ REPEAT DROP CR
"REPEAT 0  " MSG 9 BEGIN DUP 5 GT IF DUP = 1+ REPEAT = CR
"DO        " MSG 5 0 DO I = LOOP CR
"DO 3 7    " MSG 7 3 DO I = LOOP CR
"DO ZERO   " MSG 0 0 DO I = LOOP 0 5 DO I = LOOP "." MSG CR
"DO NEG    " MSG 0 -3 DO I = LOOP CR
"+LOOP 3   " MSG 10 0 DO I = 3 +LOOP CR
"+LOOP 10  " MSG 10 0 DO I = 10 +LOOP CR
"+LOOP -1  " MSG 0 5 DO I = -1 +LOOP "." MSG CR
"I J       " MSG 3 0 DO 2 0 DO J 10 * I + = LOOP LOOP CR
"I J K     " MSG 2 0 DO 2 0 DO 2 0 DO K 100 * J 10 * + I + = LOOP LOOP LOOP CR
"I'        " MSG 5 0 DO I' = LOOP CR
"I' 3 7    " MSG 7 3 DO I' = LOOP CR
"LAST_I    " MSG 5 0 DO LOOP LAST_I = CR
"EXIT      " MSG 10 0 DO I = I 3 EQ IF EXIT THEN LOOP CR
"EXIT LAST " MSG 10 0 DO I 3 EQ IF EXIT THEN LOOP LAST_I = CR
"PAREN     " MSG 5 ( I = ) CR
"PAREN 0   " MSG 0 ( I = ) -2 ( I = ) "." MSG CR
"PAREN NEST" MSG 2 ( 3 ( J 10 * I + = ) ) CR
'CNT : 0 DO I = LOOP ;
"DO IN DEF " MSG 4 CNT 2 CNT CR
% A STRUCTURE OPEN ACROSS LINES: THE LINES ACCUMULATE UNTIL CHECK IS 0
"MULTILINE " MSG
3 0 DO
  I =
LOOP CR
