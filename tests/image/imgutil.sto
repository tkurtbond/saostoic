% IMGUTIL: HELPERS FOR THE IMAGE TESTS, BUILT FROM IMAGE'S OWN WORDS
% (STOIC/IMAGE).  EVERYTHING IS PRINTED IN HEX.
%
% IORB<< PUSHES THE IORB BRANCH.  IORB< ITSELF CANNOT BE USED IN THE
% SHIPPED EXE: BRANCH (RDEF:943) COMPILED THE ABSOLUTE ADDRESS OF THE
% BRANCH CELL, USER_DATA+491, WHEN THE DATA REGION WAS AT 7A400, AND ON
% V5.5-2 IT IS ELSEWHERE.  491 IS HEX: SET HEX FIRST, AS THE CALLER MAY BE
% IN DECIMAL (AN EXE MADE BY IMAGE STARTS IN ITS PARENT'S RADIX).
HEX
'IORB<< : USER_DATA @ 491 + V_PUSH ;
IORB<<
% HDR READS VBN 1 OF A FILE INTO HEAD, AS .IMAGE DOES WITH HEAD0.
'HDR :  % FILE NAME, HDR
  INIT_FRABS HEAD0_FRAB CUR_FRAB !
  COUNT FAB.M_GET FOPEN SYSERR
  1 HEAD 200 FRANDOGET SYSERR DROP
  FCLOSE ;
% HINFO PRINTS THE HEADER FIELDS IMAGE RELIES ON: IHD$W_SIZE (+0), THE
% OFFSET OF THE FIRST ISD; THE FIRST TRANSFER ADDRESS (AT IHD$W_ACTIVOFF,
% +2); IHD$B_HDRBLKCNT (+10).  SHOW (IMAGE:252) PRINTS THE ISDS.
'HINFO :
  "HDRBLKCNT=" MSG HEAD 10 + B@ <#> TYPE
  " ISDOFF=" MSG HEAD W@ <#> TYPE
  " TRANSFER=" MSG HEAD DUP 2+ W@ + @ <#> TYPE CR ;
'HSHOW : HDR HINFO SHOW ;
>
% PTRS PRINTS WHAT UPDATE_POINTERS AND CHECK_ISD USE.
'PTRS :
  "DATA_0=" MSG DATA_0 @ <#> TYPE " USER_DATA=" MSG USER_DATA @ <#> TYPE
  " LEN=" MSG .D @ USER_DATA @ - <#> TYPE CR
  "DICT_0=" MSG DICT_0 @ <#> TYPE " USER_DICTIONARY=" MSG USER_DICTIONARY @ <#> TYPE
  " DICT_PNTR=" MSG DICT_PNTR @ <#> TYPE CR
  "CODE_0=" MSG CODE_0 @ <#> TYPE " USER_CODE=" MSG USER_CODE @ <#> TYPE
  " CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE CR ;
DECIMAL
