E2 :== $DUA1:[USERS.CLAUDE.WORK]E2.TMP
WRITE SYS$COMMAND "RUN E2"
E2 HEX "USER_DATA " MSG USER_DATA @ <#> TYPE CR ;F
E2 HEX "O.BUFSTRT-USER_DATA " MSG O.BUFSTRT USER_DATA @ - <#> TYPE CR ;F
E2 HEX "STACK " MSG 41 STK BPUSH STK 4+ @ B@ <#> TYPE CR ;F
E2 FLODEF "VARIABLE " MSG FV .@ .= CR ;F
E2 IORB< "IORB< " MSG VOCAB_SP @ @ USER_DATA @ - <#> TYPE > CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
E2W :== $DUA1:[USERS.CLAUDE.WORK]E2W.TMP
WRITE SYS$COMMAND "RUN E2W"
E2W HEX "USER_DATA " MSG USER_DATA @ <#> TYPE CR ;F
E2W HEX "O.BUFSTRT-USER_DATA " MSG O.BUFSTRT USER_DATA @ - <#> TYPE CR ;F
E2W HEX "STACK " MSG 41 STK BPUSH STK 4+ @ B@ <#> TYPE CR ;F
E2W FLODEF "VARIABLE " MSG FV .@ .= CR ;F
E2W IORB< "IORB< " MSG VOCAB_SP @ @ USER_DATA @ - <#> TYPE > CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
