#!/bin/sh
# Runs the IMAGE tests (doc/image.md) and writes each group's output to
# tests/image/results/<group>.txt. SETUP.COM must have been run once with
# tools/vax-do. These are not in tools/stoic-suite: they make exes, and
# group loop never ends by itself.
#
#   tests/image/run [group...]
#
#   a-ship  shipped STOIC.EXE with the shipped HEAD0: two layers of IMAGE,
#           a shareable image, SAVE/XLOAD across images
#   a-new   the same with the rebuilt STOIC.EXE and HEAD0 (;2)
#   a-pat   the same with the Phase 6 patched STOIC.EXE and its HEAD0
#   b       the limits: data window, data size, dictionary window, no
#           HEAD0, a HEAD0 from another build, IMAGE inside a LOAD
#   d       defect 22: IORB< in the shipped and the rebuilt STOIC.EXE
#   e-new   defects 22 and 30: a STOIC with a STACK and a .VARIABLE, run as
#           made (E2) and with P0 ending 40000 higher (E2W, from WIDEN.STO,
#           as on a system with larger shareables), with the rebuild
#   e-pat   the same with the patched build (fixed data address)
#   f       the room left in each window: the region pointers of the
#           shipped, rebuilt and patched STOIC.EXE and RED.EXE
#   g       Phase 7: code past the old code window, made into an exe with
#           the patched build and run there
#   loop    the code window: ends in an endless fault loop, so it is cut
#           off by a short timeout and only its head is kept
cd "$(dirname "$0")/../.." || exit 2
T=tests/image
R=$T/results
# STOIC_TREE names another tree, such as current: its exes are run, and
# the results go to $R/<tree>/.
tree=${STOIC_TREE:-patched}
TREE=$(echo "$tree" | tr a-z A-Z)
if [ "$tree" != patched ]; then
  R=$R/$tree
  P=${TMPDIR:-/tmp}/stoic-$tree-image; mkdir -p $P
  for f in a1-pat.dcl e1-pat.dcl; do sed "s/PATCHED/$TREE/g" tests/image/$f > $P/$f; done
else
  P=tests/image
fi
# imgutil.sto compares; current gets a copy with its comparisons swapped
U=$T/imgutil.sto
if [ "$tree" = current ]; then
  U=$P/imgutil.sto; cp $T/imgutil.sto $U; tools/cmp-swap $U >&2
fi
NEW='DUA1:[USERS.CLAUDE.WORK.SAOSTOIC.STOIC]STOIC.EXE'
PAT="DUA1:[USERS.CLAUDE.WORK.$TREE.STOIC]STOIC.EXE"
mkdir -p $R
[ $# -gt 0 ] || set -- a-ship a-new b d loop
A="$T/a2-show.sto $T/a3-make1.con $T/a4-run1.dcl $T/a5-make2.con $T/a6-run2.dcl $T/a7-xload.con"
for g; do
  case $g in
    a-ship) tools/stoic-run -m -f $U $T/a1-ship.dcl $A > $R/$g.txt 2>&1 ;;
    a-new)  tools/stoic-run -m -f $U -x "$NEW" $T/a1-new.dcl $A > $R/$g.txt 2>&1 ;;
    a-pat)  tools/stoic-run -m -f $U -x "$PAT" $P/a1-pat.dcl $A > $R/$g.txt 2>&1 ;;
    b)      tools/stoic-run -m -f $U $T/a1-ship.dcl $T/b1-datawin.sto $T/b2-bigdata.con \
              $T/b2-run.dcl $T/b4-dict.con $T/c1-nested.sto $T/c1-run.dcl \
              $T/b5-empty.dcl $T/b5-image.con $T/a1-new.dcl $T/b6-mix.con \
              $T/b6-run.dcl > $R/$g.txt 2>&1 ;;
    d)      { tools/stoic-run -m $T/d1-branch.con
              echo "--- rebuilt"; tools/stoic-run -m -x "$NEW" $T/d1-branch.con; } > $R/$g.txt 2>&1 ;;
    e-new)  tools/stoic-run -m -x "$PAT" -f $T/e2make.com -f $T/widen.sto $T/e1-new.dcl \
              $T/e3-widen.con $T/e4-run.dcl > $R/$g.txt 2>&1 ;;
    e-pat)  tools/stoic-run -m -x "$PAT" -f $T/e2make.com -f $T/widen.sto $P/e1-pat.dcl \
              $T/e3-widen.con $T/e4-run.dcl > $R/$g.txt 2>&1 ;;
    f)      for x in 'DUA1:[USERS.CLAUDE.SAOSTOIC.STOIC]STOIC.EXE' \
                     'DUA1:[USERS.CLAUDE.SAOSTOIC.RED]RED.EXE' \
                     "$NEW" 'DUA1:[USERS.CLAUDE.WORK.SAOSTOIC.RED]RED.EXE' \
                     "$PAT" "DUA1:[USERS.CLAUDE.WORK.$TREE.RED]RED.EXE"; do
                echo "--- $x"; tools/stoic-run -x "$x" $T/f1-room.con
              done > $R/$g.txt 2>&1 ;;
    g)      tools/stoic-run -m -f $U -x "$PAT" $P/a1-pat.dcl $T/g1-high.con \
              $T/g2-run.dcl > $R/$g.txt 2>&1 ;;
    loop)   VAX_DO_TIMEOUT=60 tools/stoic-run -m -f $U $T/b3-code.con 2>&1 | head -40 > $R/$g.txt ;;
    *) echo "tests/image/run: no group $g" >&2; exit 2 ;;
  esac
  echo "$g: exit $?, $(wc -l < $R/$g.txt) lines in $R/$g.txt"
done
