T1 :== $DUA1:[USERS.CLAUDE.WORK]T1.TMP
R1 :== $DUA1:[USERS.CLAUDE.WORK]R1.TMP
WRITE SYS$COMMAND "RUN T1"
T1 7 SQ = V1 @ = S1 MSG DATE @ REV0 @ NE = CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
WRITE SYS$COMMAND "RUN R1"
R1 7 SQ = CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
RUN_STOIC :== $DUA1:[USERS.CLAUDE.WORK]T1.TMP
