G1 :== $DUA1:[USERS.CLAUDE.WORK]G1.TMP
WRITE SYS$COMMAND "RUN G1"
G1 HEX "W4 " MSG W4 = "W3 " MSG W3 = CR "W4" WHERE CR ;F
G1 HEX "W5" : W4 W2 + ; "W5" WHERE CR "W5 " MSG "W5" COUNT I_LOOKUP DROP CODE_COUNT DROP EXEC = CR ;F
G1 HEX "CODE_0=" MSG CODE_0 @ <#> TYPE " USER_CODE=" MSG USER_CODE @ <#> TYPE " CODE_PNTR=" MSG CODE_PNTR @ <#> TYPE CR ;F
WRITE SYS$COMMAND F$MESSAGE($STATUS)
