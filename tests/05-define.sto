% 05-DEFINE: COLON DEFINITIONS, REDEFINITION, CONSTANT, VARIABLE, ARRAY,
% SVARIABLE, ,D, (), EXEC, IMMEDIATE (RKERNEL:815-900, RDEF:906-940).
DECIMAL
'SQ : DUP * ;
"SQ        " MSG 9 SQ = CR
% THE OLD SQ IS USED INSIDE THE NEW ONE: A DEFINITION TAKES EFFECT WHEN
% ITS LINE RUNS
'SQ : SQ 1+ ;
"REDEFINE  " MSG 9 SQ = CR
'TWO-LINE :
  DUP +
  1+ ;
"TWO LINES " MSG 5 TWO-LINE = CR
42 'K42 CONSTANT
"CONSTANT  " MSG K42 = CR
7 'V VARIABLE
"VARIABLE  " MSG V @ = 9 V ! V @ = V 1+! V @ = 3 V +! V @ = CR
"<-        " MSG V 20 <- V @ = V 0<- V @ = V -1<- V @ = CR
4 'AR ARRAY
"ARRAY     " MSG 11 AR ! 22 AR 4+ ! 33 AR 8 + ! AR @ = AR 4+ @ = AR 8 + @ = CR
"ARRAY GAP " MSG AR 4+ AR - = CR
10 'SV SVARIABLE
"SVARIABLE " MSG SV COUNT = DROP SV 2- W@ = CR
"MOVE_STR  " MSG "HELLO" SV MOVE_STRING SV MSG SV COUNT = DROP CR
"TOO LONG  " MSG "ABCDEFGHIJKLMNOP" SV MOVE_STRING SV MSG SV COUNT = DROP CR
"STAB      " MSG "AB" SV MOVE_STRING 67 SV STAB SV MSG CR
.D@ 'HERE0 CONSTANT 5 ,D 6 ,D
"B,D ,D    " MSG HERE0 @ = HERE0 4+ @ = .D@ HERE0 - = CR
"() EXEC   " MSG 6 () SQ EXEC = CR
% RECURSION THROUGH A VARIABLE HOLDING THE WORD'S ADDRESS
0 'FACTV VARIABLE
'FACT : DUP 1 LT IF DUP 1- FACTV @ EXEC * THEN ;
() FACT FACTV !
"RECURSION " MSG 5 FACT = 10 FACT = CR
'IMM : "<IMM>" MSG ; IMMEDIATE
"IMMEDIATE " MSG 'USEIMM : "BODY" MSG IMM ; CR
"AFTER     " MSG USEIMM CR
'EMPTY : ;
"EMPTY DEF " MSG EMPTY 5 = CR
