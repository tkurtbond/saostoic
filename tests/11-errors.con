% 11-ERRORS: EACH ERROR, THEN "1 =" ON THE NEXT LINE TO SHOW THE CONSOLE
% CARRIES ON.  TYPED AT THE CONSOLE, SO AN ERROR ENDS ONLY ITS LINE.
DECIMAL
'UTIL.STO LOAD
% AN UNDEFINED WORD
NOSUCHWORD
1 = CR
% A LEADING PLUS SIGN IS NOT PART OF A NUMBER
+5 =
% A WORD USED ON THE LINE THAT DEFINES IT IS NOT DEFINED YET
'CNT : 0 DO I = LOOP ; 4 CNT
CNT
2 CNT CR
% A STRUCTURE LEFT OPEN AT ;
'BAD : 1 IF 2 ;
3 = CR
% A STRING LITERAL WITH NO CLOSING QUOTE RUNS TO THE END OF THE LINE
"ABC MSG CR
MSG CR
4 = CR
% DIVIDE BY ZERO
1 0 / =
5 = CR
% FETCH FROM ADDRESS 0: ACCVIO
0 @ =
6 = CR
% STACK UNDERFLOW: DROP DOES NOT TOUCH MEMORY, SO ONLY A FETCH FAULTS
DROP DROP DROP
7 = CR
DROP DROP DROP =
8 = CR
% AFTER AN ABORT THE STACK IS EMPTY AGAIN: THE POINTER IS WHERE IT WAS
% WITH NOTHING ON IT, SO THIS PRINTS 0
SP@ SA !
1 2 0 @
SP@ SA @ - = CR
9 = CR
% LOAD OF A FILE THAT DOES NOT EXIST: LIB$STOP, SO STOIC EXITS AND
% DCL SKIPS THE REST OF THESE LINES
'NOSUCH.STO LOAD
10 = CR
