DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]
STOIC "F50.TMP" IMAGE
F = "DUA1:[USERS.CLAUDE.SAOSTOIC.STOIC]STOIC.EXE"
WRITE SYS$COMMAND "SHIPPED STOIC: RFM=", F$FILE_ATTRIBUTES(F,"RFM"), " MRS=", F$FILE_ATTRIBUTES(F,"MRS")
F = "DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]HEAD0.EXE"
WRITE SYS$COMMAND "LINKED HEAD0:  RFM=", F$FILE_ATTRIBUTES(F,"RFM"), " MRS=", F$FILE_ATTRIBUTES(F,"MRS")
F = "DUA1:[USERS.CLAUDE.WORK.PATCHED.STOIC]STOIC.EXE"
WRITE SYS$COMMAND "BUILT STOIC:   RFM=", F$FILE_ATTRIBUTES(F,"RFM"), " MRS=", F$FILE_ATTRIBUTES(F,"MRS")
WRITE SYS$COMMAND "IMAGE F50.TMP: RFM=", F$FILE_ATTRIBUTES("F50.TMP","RFM"), " MRS=", F$FILE_ATTRIBUTES("F50.TMP","MRS")
F50 = "$DUA1:[USERS.CLAUDE.WORK]F50.TMP"
F50 DECIMAL 2 3 + = CR
DELETE F50.TMP;*
