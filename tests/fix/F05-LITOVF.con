% F05-LITOVF: DEFECT 5.  INTEGER LITERALS WRAPPED MOD 2**32 SILENTLY.  THE
% PATCHED DIGIT KEEPS A 64-BIT PRODUCT AND ICOMPILE REFUSES ANYTHING OVER
% 32 BITS; UP TO FFFFFFFF STAYS LEGAL.  A FLOAT MAY BE ANY LENGTH.
DECIMAL
"MAX      " MSG 4294967295 <#> TYPE SPACE 2147483648 <#> TYPE SPACE -2147483648 <#> TYPE CR
"2**32    " MSG 4294967296 <#> TYPE CR
"BIG      " MSG 99999999999 <#> TYPE CR
"NEG BIG  " MSG -4294967297 <#> TYPE CR
HEX
"HEX MAX  " MSG FFFFFFFF <#> TYPE SPACE 80000000 <#> TYPE CR
"HEX 33   " MSG 100000000 <#> TYPE CR
"HEX ZEROS" MSG 0000000000FF <#> TYPE CR
DECIMAL
FLOAT<
"FLOAT    " MSG 99999999999. .= CR
>
"DONE" MSG CR
