WRITE SYS$COMMAND "THE REBUILT HEAD0: NO CODE SECTION AT CODE_0"
STOIC "F28.TMP" IMAGE
IF F$SEARCH("F28.TMP") .EQS. "" THEN WRITE SYS$COMMAND "NO F28.TMP"
WRITE SYS$COMMAND "THE REBUILT STOIC WITH THE PATCHED IMAGE AND THE SHIPPED HEAD0"
OPEN/WRITE F F28.COM
WRITE F "$ DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.SAOSTOIC.KERNEL]"
WRITE F "$ F28R = ""$DUA1:[USERS.CLAUDE.WORK.SAOSTOIC.STOIC]STOIC.EXE;2"""
WRITE F "$ F28R"
WRITE F """DUA1:[USERS.CLAUDE.WORK.PATCHED.STOIC]IMAGE."" LOAD"
WRITE F """F28B.TMP"" IMAGE"
WRITE F "$ WRITE SYS$COMMAND ""THE SAME WITH THE REBUILT HEAD0"""
WRITE F "$ F28R"
WRITE F """DUA1:[USERS.CLAUDE.WORK.PATCHED.STOIC]IMAGE."" LOAD"
WRITE F """F28C.TMP"" IMAGE"
CLOSE F
@F28.COM
IF F$SEARCH("F28B.TMP") .EQS. "" THEN WRITE SYS$COMMAND "NO F28B.TMP"
IF F$SEARCH("F28C.TMP") .NES. "" THEN WRITE SYS$COMMAND "F28C.TMP MADE"
DELETE F28.COM;*,F28C.TMP;*
