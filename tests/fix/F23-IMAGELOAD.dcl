OPEN/WRITE F F23.STO
WRITE F """F23.TMP"" IMAGE ""AFTER IMAGE"" MSG CR"
CLOSE F
DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]
STOIC "F23.STO" LOAD
IF F$SEARCH("F23.TMP") .EQS. "" THEN WRITE SYS$COMMAND "NO F23.TMP"
DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]
STOIC "F23C.TMP" IMAGE "AT THE CONSOLE" MSG CR
IF F$SEARCH("F23C.TMP") .NES. "" THEN WRITE SYS$COMMAND "F23C.TMP MADE"
DELETE F23.STO;*,F23C.TMP;*
