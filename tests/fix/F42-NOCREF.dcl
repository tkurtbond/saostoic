COPY DUA1:[USERS.CLAUDE.WORK.PATCHED.STOIC]STOIC.EXE F42.TMP
COPY DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]HEAD0.EXE F42H.TMP
OPEN/WRITE F F42.STO
WRITE F "IORB<"
WRITE F """NOCREF ALONE"" MSG CR ""F42.TMP"" NOCREF"
WRITE F """AFTER INIT_FRABS, AN EXE MADE BY IMAGE"" MSG CR INIT_FRABS ""F42.TMP"" NOCREF"
WRITE F """A LINKED EXE"" MSG CR INIT_FRABS ""F42H.TMP"" NOCREF ""DONE"" MSG CR"
WRITE F ">"
CLOSE F
STOIC "F42.STO" LOAD
DELETE F42.STO;*
