COPY DUA1:[USERS.CLAUDE.WORK.PATCHED.STOIC]STOIC.EXE F42.TMP
COPY DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]HEAD0.EXE F42H.TMP
OPEN/WRITE F F42.STO
WRITE F "IORB<"
WRITE F "HEX"
WRITE F """RDH"" : INIT_FRABS IMAGE_FRAB CUR_FRAB ! COUNT FAB.M_GET FAB.M_BIO OR FOPEN SYSERR"
WRITE F "  HEAD 200 FREAD SYSERR FCLOSE DROP ;"
WRITE F """AN EXE MADE BY IMAGE"" MSG CR ""F42.TMP"" RDH SHOW"
WRITE F """F42.TMP"" NOCREF ""F42.TMP"" RDH SHOW"
WRITE F """A LINKED EXE"" MSG CR ""F42H.TMP"" RDH SHOW"
WRITE F """F42H.TMP"" NOCREF ""F42H.TMP"" RDH SHOW ""DONE"" MSG CR"
WRITE F ">"
CLOSE F
STOIC "F42.STO" LOAD
F42 = "$DUA1:[USERS.CLAUDE.WORK]F42.TMP"
F42 2 3 + = CR
DELETE F42.STO;*,F42.TMP;*,F42H.TMP;*
