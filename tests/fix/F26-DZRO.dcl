DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]
STOIC 4000 "BIG" ARRAY "F26.TMP" IMAGE
IF F$SEARCH("F26.TMP") .EQS. "" THEN WRITE SYS$COMMAND "NO F26.TMP"
DEFINE/USER SAO$KERNEL DUA1:[USERS.CLAUDE.WORK.PATCHED.KERNEL]
STOIC 3000 "BIG" ARRAY "F26B.TMP" IMAGE
IF F$SEARCH("F26B.TMP") .NES. "" THEN WRITE SYS$COMMAND "F26B.TMP MADE"
IF F$SEARCH("F26B.TMP") .NES. "" THEN DELETE F26B.TMP;*
