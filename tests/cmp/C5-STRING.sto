% C5-STRING: STRING VARIABLES AT THEIR LIMITS.  STAB (RDEF:1254) ADDS A
% BYTE ONLY WHILE THE COUNT IS BELOW THE MAXIMUM.  .STRAP AND .MOVE_STRING
% USE IT, AND .STRAP SKIPS A SOURCE WHOSE LENGTH IS NOT ABOVE ZERO.  EACH
% LINE PRINTS THE STRING BETWEEN BARS AND THEN ITS COUNT.
DECIMAL
5 'SV SVARIABLE  0 'SZ SVARIABLE  10 'SL SVARIABLE
'SHOWS : "|" MSG DUP MSG "|" MSG COUNT = DROP CR ;
"STAB 4  " MSG SV 0W<- 4 ( ASCII A I + SV STAB ) SV SHOWS
"STAB 5  " MSG SV 0W<- 5 ( ASCII A I + SV STAB ) SV SHOWS
"STAB 6  " MSG SV 0W<- 6 ( ASCII A I + SV STAB ) SV SHOWS
"STAB 9  " MSG SV 0W<- 9 ( ASCII A I + SV STAB ) 99 = SV SHOWS
"STAB Z  " MSG SZ 0W<- ASCII Q SZ STAB 99 = SZ SHOWS
"STRAP 0 " MSG SL 0W<- "XYZ" COUNT DROP 0 SL .STRAP 99 = SL SHOWS
"STRAP -1" MSG SL 0W<- "XYZ" COUNT DROP -1 SL .STRAP 99 = SL SHOWS
"STRAP 1 " MSG SL 0W<- "XYZ" COUNT DROP 1 SL .STRAP SL SHOWS
"STRAP 3+" MSG "XYZ" COUNT SL .STRAP "XYZ" COUNT SL .STRAP SL SHOWS
"STRAP 4+" MSG "PQRS" COUNT SL .STRAP 99 = SL SHOWS
"MOVE 10 " MSG "0123456789" SL MOVE_STRING SL SHOWS
"MOVE 11 " MSG "ABCDEFGHIJK" SL MOVE_STRING 99 = SL SHOWS
"MOVE 4  " MSG "WXYZ" SL MOVE_STRING SL SHOWS
"STRAP S " MSG "ABCDEFGH" SV MOVE_STRING SV SHOWS
"AFTER   " MSG 12345 = CR
