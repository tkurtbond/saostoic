% C3-MOVE: MOVE_BYTES (RDEF:754) AND MOVE_WORDS (RDEF:1211).  MOVE_BYTES
% MOVES A COUNT UP TO FFFF WITH ONE MOVC3, AND A LONGER ONE IN GROUPS,
% FROM THE END WHEN THE DESTINATION IS ABOVE THE SOURCE AND FROM THE
% START WHEN IT IS NOT.  THE COUNTS HERE ARE EACH SIDE OF FFFF, AND THE
% MOVES GO BOTH WAYS, APART AND OVERLAPPING.  MOVE_WORDS TAKES SOURCE,
% COUNT OF LONGWORDS, DESTINATION (ITS COMMENT SAYS SOURCE, DEST, COUNT).
% THE SCRATCH AREA IS FREE CODE SPACE PAST CODE_PNTR; THE PATCHED STOIC
% HAS ABOUT 230 KB OF IT.  BYTE I OF A PATTERN IS (I + OFFSET) MOD 251.
DECIMAL
0 'TS VARIABLE  0 'TBAD VARIABLE  0 'TA VARIABLE  0 'TO VARIABLE  0 'TN VARIABLE
'TFILL :  % address, count, offset, TFILL
  TO ! SWAP TA ! ( I TO @ + 251 MOD TA @ I + B! )
  ;
'TZERO :  % address, count, TZERO
  SWAP TA ! ( 0 TA @ I + B! )
  ;
'TCHECK :  % address, count, offset, TCHECK, number of bytes not in pattern
  TO ! SWAP TA ! TBAD 0<-
  ( TA @ I + B@ I TO @ + 251 MOD NE_IF TBAD 1+! THEN )
  TBAD @
  ;
'SRC : TS @ ;
'DST : TS @ 73728 + ;
% APART: SOURCE BELOW, THEN ABOVE, THE DESTINATION
'TAPART :  % count, TAPART
  TN !
  SRC TN @ 16 + 0 TFILL  DST TN @ 16 + TZERO
  SRC TN @ DST MOVE_BYTES
  DST TN @ 0 TCHECK =  DST TN @ + B@ =
  DST TN @ 16 + 7 TFILL  SRC TN @ 16 + TZERO
  DST TN @ SRC MOVE_BYTES
  SRC TN @ 7 TCHECK =  SRC TN @ + B@ =
  ;
% OVERLAPPING BY 256: DESTINATION ABOVE, THEN BELOW, THE SOURCE
'TOVER :  % count, TOVER
  TN !
  SRC TN @ 256 + 0 TFILL
  SRC TN @ SRC 256 + MOVE_BYTES
  SRC 256 + TN @ 0 TCHECK =  SRC 256 0 TCHECK =
  SRC TN @ 256 + 0 TFILL
  SRC 256 + TN @ SRC MOVE_BYTES
  SRC TN @ 256 TCHECK =  SRC TN @ + 256 TN @ TCHECK =
  ;
CODE_PNTR @ 4096 + TS !
"APART 1     " MSG 1 TAPART CR
"APART 65534 " MSG 65534 TAPART CR
"APART 65535 " MSG 65535 TAPART CR
"APART 65536 " MSG 65536 TAPART CR
"APART 65537 " MSG 65537 TAPART CR
"APART 69632 " MSG 69632 TAPART CR
"APART 0     " MSG SRC 16 0 TFILL DST 16 TZERO SRC 0 DST MOVE_BYTES DST 16 TZERO DST 16 0 TCHECK = CR
"OVER 300    " MSG 300 TOVER CR
"OVER 65535  " MSG 65535 TOVER CR
"OVER 65536  " MSG 65536 TOVER CR
"OVER 65537  " MSG 65537 TOVER CR
"OVER 69632  " MSG 69632 TOVER CR
% MOVE_WORDS: FFFC AND 10000 BYTES
"WORDS 16383 " MSG SRC 65552 0 TFILL DST 65552 TZERO SRC 16383 DST MOVE_WORDS DST 65532 0 TCHECK = DST 65532 + B@ = CR
"WORDS 16384 " MSG SRC 65552 0 TFILL DST 65552 TZERO SRC 16384 DST MOVE_WORDS DST 65536 0 TCHECK = DST 65536 + B@ = CR
"STACK       " MSG 99 = CR
