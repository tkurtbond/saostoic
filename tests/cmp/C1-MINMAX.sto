% C1-MINMAX: MIN, MAX AND ABS (RDEF:650-665) AT THE BOUNDARIES: EQUAL,
% ONE APART, EACH SIGN, AND 7FFFFFFF AGAINST 80000000.  THE 99 UNDER
% EACH PAIR SHOWS THAT ONE VALUE IS LEFT, AND WHICH.  NO TEST IN
% TESTS/CMP NAMES A COMPARISON WORD: THE OUTPUT MUST NOT CHANGE IN CMPFIX.
DECIMAL
"MAX EQ   " MSG 99 5 5 MAX = = 99 -5 -5 MAX = = 99 0 0 MAX = = CR
"MAX ONE  " MSG 4 5 MAX = 5 4 MAX = -1 0 MAX = 0 -1 MAX = -2 -1 MAX = CR
"MAX SIGN " MSG -3 3 MAX = 3 -3 MAX = 99 -1 1 MAX = = CR
"MIN EQ   " MSG 99 5 5 MIN = = 99 -5 -5 MIN = = 99 0 0 MIN = = CR
"MIN ONE  " MSG 4 5 MIN = 5 4 MIN = -1 0 MIN = 0 -1 MIN = -2 -1 MIN = CR
"MIN SIGN " MSG -3 3 MIN = 3 -3 MIN = 99 -1 1 MIN = = CR
"ABS      " MSG 0 ABS = 1 ABS = -1 ABS = 2147483647 ABS = -2147483647 ABS = CR
HEX
"MAX EXT  " MSG 7FFFFFFF 80000000 MAX = 80000000 7FFFFFFF MAX = CR
"MAX EXT1 " MSG 7FFFFFFE 7FFFFFFF MAX = 80000001 80000000 MAX = CR
"MIN EXT  " MSG 7FFFFFFF 80000000 MIN = 80000000 7FFFFFFF MIN = CR
"MIN EXT1 " MSG 7FFFFFFE 7FFFFFFF MIN = 80000001 80000000 MIN = CR
"ABS EXT  " MSG 80000000 ABS = 80000001 ABS = 7FFFFFFF ABS = CR
"MAX ZERO " MSG 0 80000000 MAX = 7FFFFFFF 0 MAX = FFFFFFFF 1 MAX = CR
"MIN ZERO " MSG 0 80000000 MIN = 7FFFFFFF 0 MIN = FFFFFFFF 1 MIN = CR
