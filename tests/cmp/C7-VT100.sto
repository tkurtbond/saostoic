% C7-VT100: THE VT100 SEQUENCES, CAUGHT IN OBUF'S BUFFER (VT100 IS LOADED
% AFTER OBUF, SO ITS TYO AND TYPE ARE THE BUFFERED ONES).  SHOWBUF TURNS
% BUFFERING OFF AND TYPES THE BYTES WITH ESC AS $ AND LF AS /.  STBM (VT100
% 116) SENDS ONLY WHEN THE MARGINS CHANGE; SCROLL (VT100:124) USES RI WHEN
% N IS ABOVE M, LF WHEN IT IS BELOW, AND EL WHEN THEY ARE EQUAL.  SET_VTBITS
% (VT100:297) TAKES AT MOST NUM_SETUPS ONE-OR-ZERO CHARACTERS.  STBM TAKES
% BOTTOM, TOP (ITS COMMENT AT VT100:116 SAYS "TOP, BOTTOM").  SET_MODE AND
% RESET_MODE ARE DEFINED TWICE: VT100:59 TAKES A NUMBER, AND VT100:149, THE
% ONE IN USE, AN ASCII CHARACTER.  LIGHT_BACKGROUND AND WRAP_OFF USE THE FIRST.
HEX
'SHOWBUF :
  O.FLAG 0<-
  O.BUFCUR @ O.BUFSTRT - (
    O.BUFSTRT I + B@
    DUP 1B EQ_IF DROP ASCII $ THEN
    DUP 0A EQ_IF DROP ASCII / THEN
    DUP 0D EQ_IF DROP ASCII \ THEN
    TYO )
  "|" MSG CR
  ;
'SHOWBITS : NUM_SETUPS ( USER_BITS I + B@ #A TYO ) CR ;
DECIMAL
"CUP     " MSG BUFFER_ON 3 5 CUP 1 1 CUP 100 24 CUP 0 0 CUP -1 2 CUP SHOWBUF
"LOW     " MSG BUFFER_ON SC RC RI 0 SGR 7 SGR 2 ED 0 EL ASCII 5 SET_MODE ASCII 5 RESET_MODE SHOWBUF
"MODES   " MSG BUFFER_ON LIGHT_BACKGROUND DARK_BACKGROUND WRAP_OFF SHOWBUF
"NAMED   " MSG BUFFER_ON BOLD STEADY ERASE_SCREEN ERASE_THIS_LINE DHLT SWL GRAPHICS LCASE SHOWBUF
"SPACES  " MSG BUFFER_ON 0 SPACES -1 SPACES 3 SPACES ASCII X TYO "AB" COUNT DROP 0 TYPE CR SHOWBUF
"STBM 1  " MSG 0 TBM ! 0 TBM 4 + ! BUFFER_ON 5 10 STBM SHOWBUF
"STBM 2  " MSG BUFFER_ON 5 10 STBM SHOWBUF
"STBM 3  " MSG BUFFER_ON 5 11 STBM 6 11 STBM 6 11 STBM SHOWBUF
"TBM     " MSG TBM @ = TBM 4 + @ = CR
"SCR 3 8 " MSG 0 TBM ! BUFFER_ON 3 8 SCROLL SHOWBUF
"SCR 8 3 " MSG 0 TBM ! BUFFER_ON 8 3 SCROLL SHOWBUF
"SCR 4 4 " MSG 0 TBM ! BUFFER_ON 4 4 SCROLL SHOWBUF
"SCR 3 4 " MSG 0 TBM ! BUFFER_ON 3 4 SCROLL 4 3 SCROLL SHOWBUF
"SCR -1 0" MSG 0 TBM ! BUFFER_ON -1 0 SCROLL 0 -1 SCROLL SHOWBUF
"NSETUPS " MSG NUM_SETUPS = CR
"BITS 0  " MSG NUM_SETUPS ( 7 USER_BITS I + B! ) SHOWBITS
"BITS 4  " MSG "1010" COUNT SET_VTBITS SHOWBITS
"BITS X  " MSG "0X1 1Y0" COUNT SET_VTBITS SHOWBITS
"BITS 17 " MSG "11111111111111111" COUNT SET_VTBITS SHOWBITS
"BITS 16 " MSG "0000000000000000" COUNT SET_VTBITS SHOWBITS
"BITS 20 " MSG "00000000000000000000" COUNT SET_VTBITS SHOWBITS
"BITS 1  " MSG "1" COUNT SET_VTBITS 0 0 SET_VTBITS SHOWBITS
"AFTER   " MSG 12345 = CR
