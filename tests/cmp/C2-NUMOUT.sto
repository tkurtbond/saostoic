% C2-NUMOUT: NUMBER OUTPUT.  #A (RDEF:1172) MAKES A DIGIT BELOW 10 A
% NUMERAL AND ONE FROM 10 UP A LETTER, AND REFUSES ONE AT OR ABOVE THE
% RADIX ("OUTPUT CONVERSION ERROR.").  #, #S, <#>, =, I= AND D<#>
% (VT100:21) ALL GO THROUGH IT, AND #PUT THROUGH BPUSH (RDEF:1140).
% ABORT IS I_ABORT HERE, SO AN ERROR PRINTS NO TRACEBACK.  EACH LINE SETS
% THE RADIX IT PRINTS IN; ITS LITERALS ARE DECIMAL.
DECIMAL
() I_ABORT ABORT !
"DEC    " MSG 0 = 9 = 10 = 99 = 100 = -1 = -10 = 2147483647 = -2147483648 = CR
"BIN    " MSG 2 RADIX ! 0 = 1 = 2 = 5 = -1 = 10 RADIX ! CR
"BIN MAX" MSG 2 RADIX ! 2147483647 = -2147483648 = 10 RADIX ! CR
"OCT    " MSG 8 RADIX ! 7 = 8 = 63 = 64 = -8 = 10 RADIX ! CR
"HEX    " MSG 16 RADIX ! 9 = 10 = 15 = 16 = 255 = -16 = 10 RADIX ! CR
"R36    " MSG 36 RADIX ! 9 = 10 = 35 = 36 = 1295 = 1296 = -35 = 10 RADIX ! CR
"R37    " MSG 37 RADIX ! 35 = 36 = 37 = 10 RADIX ! CR
"#A DEC " MSG 0 #A TYO 9 #A TYO CR
"#A HEX " MSG 16 RADIX ! 0 #A TYO 9 #A TYO 10 #A TYO 15 #A TYO 10 RADIX ! CR
"#A R36 " MSG 36 RADIX ! 10 #A TYO 35 #A TYO 10 RADIX ! CR
% A NEGATIVE DIGIT PASSES BOTH TESTS AND COMES OUT BELOW "0"
"#A NEG " MSG -1 #A TYO -10 #A TYO CR
"#A 10  " MSG 10 #A TYO "NOT REACHED" MSG CR
"#A 11  " MSG 11 #A TYO "NOT REACHED" MSG CR
"#A H16 " MSG 16 RADIX ! 16 #A TYO "NOT REACHED" MSG CR
DECIMAL
"#A H17 " MSG 16 RADIX ! 17 #A TYO "NOT REACHED" MSG CR
DECIMAL
% 80000000 IS NEGATIVE TOO, SO IT PASSES AND PRINTS AS "0" PLUS 80000000
"#A BIG " MSG -2147483648 #A TYO "NOT REACHED" MSG CR
"<#>    |" MSG 0 <#> TYPE "|" MSG -7 <#> TYPE "|" MSG 1000000 <#> TYPE "|" MSG CR
"# #S   |" MSG 16 RADIX ! <# 4660 # # #> TYPE "|" MSG <# 4660 #S #> TYPE "|" MSG 10 RADIX ! CR
"I=     |" MSG 5 4 I= "|" MSG 123 3 I= "|" MSG 0 3 I= "|" MSG 12345 3 I= "|" MSG CR
"I= -1  |" MSG -1 12 I= "|" MSG CR
"D<#>   " MSG 16 RADIX ! 31 D<#> TYPE 255 = -31 D<#> TYPE 10 RADIX ! CR
"AFTER  " MSG 12345 = CR
