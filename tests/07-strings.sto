% 07-STRINGS: STRING LITERALS AND STRING WORDS (RDEF MOVE_WORDS ...
% +SPACES).  A STRING IS A POINTER TO A WORD-COUNTED STRING.
DECIMAL
"LITERAL " MSG "A B  C" MSG "|" MSG CR
"QUOTE   " MSG 'ABC MSG CR
% WORD SKIPS A RUN OF QUOTES, SCANS TO THE NEXT QUOTE, AND SKIPS THE RUN
% THERE; SLITERAL THEN DROPS THE FIRST AND LAST CHARACTERS
"QUOTES  |" MSG ""AB" MSG "|" MSG "CD"" MSG "|" MSG CR
"ADJOIN  |" MSG "EF"MSG "|" MSG CR
"COUNT   " MSG "HELLO" COUNT = DROP 'HI COUNT = DROP CR
"TYPE    " MSG "HELLO" COUNT 2- TYPE CR
10 'S SVARIABLE
"SVAR    " MSG S COUNT = DROP S 2- W@ = CR
"MOVE    " MSG "HELLO" S MOVE_STRING S MSG S COUNT = DROP CR
"STAB    " MSG ASCII ! S STAB S MSG CR
"STRAP   " MSG " WORLD" S STRAP S MSG S COUNT = DROP CR
"STAB FULL " MSG ASCII ? S STAB S MSG CR
"STREQ   " MSG "ABC" COUNT "ABC" COUNT .STREQ = "ABC" COUNT "ABD" COUNT .STREQ = "AB" COUNT "ABC" COUNT .STREQ = CR
"SUBSTR  " MSG "XYZ" COUNT "ABCXYZDEF" COUNT (SUBSTRING) = TYPE CR
"NOSUB   " MSG "QQ" COUNT "ABCXYZDEF" COUNT (SUBSTRING) = = DROP CR
"SEARCH  " MSG "XYZ" COUNT "ABCXYZDEF" COUNT SEARCH_STRING = 2DROP TYPE CR
5 'T SVARIABLE
"+SPACES |" MSG T +SPACES T MSG "|" MSG T COUNT = DROP CR
"CONSTS  " MSG CRET = LFEED = BLANK = CR
% SO "" IS NOT AN EMPTY STRING: IT RUNS ON TO THE NEXT QUOTE.  HERE THAT
% LEAVES |" UNDEFINED, WHICH ENDS THE FILE
"EMPTY   |" MSG "" MSG "|" MSG CR
